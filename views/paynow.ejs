<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CAG Revamped - Electricity Usage</title>
</head>
<body>
    <h2>Electricity Usage</h2>
    <canvas id="usageChart" width="800" height="400"></canvas>

    <script type="module">
        import { readExcel } from '/script/excelReader.js';
        import { plotChart } from '/script/plotChart.js';

        async function main() {
            // Excel file path
            const fileUrl = 'public/excel/03 App Portal.url.xlsx';
            
            const { monthList, kWhList } = await readExcel(fileUrl);
            plotChart(monthList, kWhList);
        }

        main();
    </script>
</body>
</html>
