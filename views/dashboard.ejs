<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <link rel="stylesheet" href="/stylesheets/glass.css">
  <title>ESG Centre Dashboard</title>

  <style>
    body {
      background-image: url("/images/Republic-Polytechnic.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }

    .mini-dashboard {
      margin: 40px auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      max-width: 1400px;
      justify-content: center;
      gap: 24px;
    }

    .mini-card {
      border-radius: 22px;
      padding: 22px 24px;
      cursor: pointer;
      min-height: 240px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .mini-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 30px rgba(0,0,0,0.4);
    }

    .mini-card h5 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .mini-value {
      font-size: 2.4rem;
      font-weight: 800;
      margin-bottom: 10px;
    }

    .mini-card canvas {
      height: 190px !important;
    }

    .carousel-item {
      height: 600px;
    }

    .video-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    img#rpmapImg {
      width: 100%;
      max-width: 900px;
    }
  </style>

  <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
</head>

<body class="<%= displayMode ? 'display-3x1' : 'presenter' %>">

  <%- include('partials/navbar.ejs') %>

  <div class="container mt-4 text-center">
    <h2 class="glass glass-heading mb-4">RP Resource Usage Summary. Last 6 Months.</h2>

    <div class="mini-dashboard">

