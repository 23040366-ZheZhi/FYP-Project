      </div>

      <div class="mini-card glass" onclick="window.location.href='/watergraph'">
        <h5>RP Average Monthly Water Consumption. m³</h5>
        <div id="miniWaterValue" class="mini-value">Loading...</div>
        <canvas id="miniWaterChart"></canvas>
      </div>

      <div class="mini-card glass" onclick="window.location.href='/waste'">
        <h5>RP Average Monthly Waste Disposed. kg</h5>
        <div id="miniWasteValue" class="mini-value">Loading...</div>
        <canvas id="miniWasteChart"></canvas>
      </div>


      <div class="mini-card glass">
        <h5>Highest Monthly Electricity Consumption. Last 6 Months.</h5>
        <div id="miniEnergyPeak" class="mini-value">Loading...</div>
        <p>Highest month in the last 6 months</p>
      </div>

      <div class="mini-card glass">
        <h5>Highest Monthly Solar Energy Generation. Last 6 Months.</h5>
        <div id="miniSolarPeak" class="mini-value">Loading...</div>
        <p>Highest month in the last 6 months</p>
      </div>

      <div class="mini-card glass">
        <h5>Highest Monthly Water Consumption. Last 6 Months.</h5>
        <div id="miniWaterPeak" class="mini-value">Loading...</div>
        <p>Highest month in the last 6 months</p>
      </div>

      <div class="mini-card glass">
        <h5>Highest Monthly Waste Disposed. Last 6 Months.</h5>
        <div id="miniWastePeak" class="mini-value">Loading...</div>
        <p>Highest month in the last 6 months</p>
      </div>

    </div>
  </div>

  <div class="container mt-5 text-center" style="padding-bottom:110px;">
    <h2 class="glass glass-heading mb-3">Interactive 3D Campus Map</h2>

    <div class="model-wrap">
      <model-viewer
      id="campusModel"
      src="/models/campusmap.glb"
      camera-controls
      auto-rotate
      environment-image="neutral"
      interaction-prompt="none"
      touch-action="none"
      shadow-intensity="1"
      exposure="0.5"
      camera-orbit="0deg 50deg 45m"
      camera-target="0m 0m 0m"
      field-of-view="35deg"
      min-camera-orbit="auto auto 8m"
      max-camera-orbit="auto auto 80m"
      style="width:100%;height:600px;background:#fff;border-radius:20px; ">
    </model-viewer>
    </div>
    <div class="overlay-buttons">
      <a href="/energy" class="map-btn">Energy</a>
      <a href="/water" class="map-btn">Water</a>
      <a href="/solar" class="map-btn">Solar</a>
