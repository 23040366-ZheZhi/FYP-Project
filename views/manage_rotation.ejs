<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Auto Rotation</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<%- include("partials/navbar.ejs") %>

<div class="container mt-5" style="max-width:600px;">
  <h3 class="mb-4">Auto Page Rotation</h3>

  <form method="POST" action="/manage-rotation">

    <div class="form-check mb-3">
      <input
        class="form-check-input"
        type="checkbox"
        id="enabled"
        name="enabled"
        <%= cfg.enabled ? "checked" : "" %>
      >
      <label class="form-check-label" for="enabled">
        Enable auto rotation
      </label>
    </div>

    <div class="mb-3">
      <label class="form-label">Idle seconds before rotate</label>
      <input
        class="form-control"
        type="number"
        name="idleSeconds"
        min="5"
        max="600"
        value="<%= cfg.idleSeconds %>"
        required
      >
    </div>

    <div class="mb-3">
      <label class="form-label">Routes to rotate, one per line</label>
      <textarea
        class="form-control"
        rows="6"
        name="routes"
        required
      ><%= cfg.routes.join("\n") %></textarea>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">
      Save
    </button>
  </form>

  <a href="/manage_graph" class="btn btn-secondary btn-lg w-100 mt-3">
    Back
  </a>
</div>

</body>
</html>
