<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Water Consumption by Building</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root{
      --bg:#f3f4f6;
      --card:#ffffff;
      --text:#111827;
      --muted:#6b7280;
      --border:rgba(0,0,0,.10);
      --shadow:0 8px 20px rgba(0,0,0,.08);
      --focus:rgba(59,130,246,.15);

      /* ===== HOLO THEME ===== */
      --neon:#57d7ff;
      --neon2:#4aa3ff;
    }

    body{
      margin:0;
      font-family:Arial, sans-serif;
      padding:10px;

      /* ===== FUTURISTIC CONTROL ROOM BACKDROP ===== */
      background:
        radial-gradient(900px 500px at 50% 10%, rgba(87,215,255,.12), transparent 60%),
        radial-gradient(700px 400px at 30% 55%, rgba(74,163,255,.10), transparent 60%),
        #0b1220;

      color:rgba(255,255,255,.92);
    }

    h2{
      text-align:center;
      margin:10px 0 18px;
      font-size:20px;
      font-weight:800;
      position:relative;
      z-index:1;
      text-shadow: 0 0 14px rgba(87,215,255,.18);
    }

    /* ===== SPLIT-SCREEN PIPE (CENTERED) ===== */
    .pipeline{
      position:fixed;
      top:0;
      bottom:0;
      left:50%;
      transform:translateX(-50%);
      width:64px;             /* slightly thicker */
      z-index:0;
      pointer-events:none;
      filter: drop-shadow(0 0 18px rgba(87,215,255,.28));
    }

    .pipeline::before{
      content:"";
      position:absolute;
      inset:0;
      border-radius:40px;
      background:linear-gradient(
        to right,
        rgba(255,255,255,.08),
        rgba(255,255,255,.22),
        rgba(255,255,255,.08)
      );
      box-shadow:
        inset 0 0 14px rgba(255,255,255,.20),
        0 0 26px rgba(87,215,255,.22);
    }

    .pipeline-water{
      position:absolute;
      inset:6px;
      border-radius:30px;
      overflow:hidden;
      background:linear-gradient(
        to bottom,
        rgba(59,130,246,.55),
        rgba(87,215,255,.82),
        rgba(59,130,246,.55)
      );
    }

    .pipeline-water::before{
      content:"";
      position:absolute;
      inset:-200% 0;
      background:linear-gradient(
        to bottom,
        transparent,
        rgba(255,255,255,.35),
        transparent
      );
      opacity:.9;
      animation:waterFlow 6s linear infinite;
    }

    @keyframes waterFlow{
      from{ transform:translateY(0); }
      to{ transform:translateY(50%); }
    }

    .pipe-bubble{
      position:absolute;
      bottom:-20px;
      border-radius:50%;
      background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.95), rgba(87,215,255,.25));
      box-shadow: 0 0 12px rgba(87,215,255,.35);
      animation:bubbleRise 5s linear infinite;
    }
    .pipe-bubble:nth-child(1){ left:50%; width:8px; height:8px; animation-delay:0s; }
    .pipe-bubble:nth-child(2){ left:30%; width:6px; height:6px; animation-delay:1.2s; }
    .pipe-bubble:nth-child(3){ left:70%; width:10px; height:10px; animation-delay:2.6s; }

    @keyframes bubbleRise{
      from{ transform:translateY(0); opacity:0; }
      10%{ opacity:.8; }
      to{ transform:translateY(-110vh); opacity:0; }
    }

    @media (max-width:950px){
      .pipeline{ display:none; }
    }

    /* ===== 2 CHARTS ===== */
    .compare-grid{
      max-width:1800px;
      width:95%;
      margin:0 auto;
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:24px;
      position:relative;
      z-index:1;
    }
    @media (max-width:950px){
      .compare-grid{ grid-template-columns:1fr; }
    }

    /* ===== HOLOGRAM CARDS (NO JS CHANGES) ===== */
    .chart-card{
      background: rgba(255,255,255,.04);
      border:1px solid rgba(87,215,255,.22);
      border-radius:14px;
      box-shadow:
        0 16px 40px rgba(0,0,0,.45),
        0 0 0 1px rgba(255,255,255,.03) inset;
      padding:10px;
      display:flex;
      flex-direction:column;
      min-height:520px;
      position:relative;
      overflow:hidden;
      backdrop-filter: blur(10px);
    }

    /* neon frame */
    .chart-card::before{
      content:"";
      position:absolute;
      inset:0;
      border-radius:14px;
      pointer-events:none;
      box-shadow:
        0 0 0 1px rgba(87,215,255,.20) inset,
        0 0 30px rgba(87,215,255,.10);
    }

    /* scanlines overlay */
    .chart-card::after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background:
        repeating-linear-gradient(
          to bottom,
          rgba(255,255,255,.06) 0px,
          rgba(255,255,255,.02) 2px,
          rgba(0,0,0,0) 5px
        ),
        radial-gradient(circle at 30% 20%, rgba(87,215,255,.10), transparent 55%);
      mix-blend-mode: screen;
      opacity: .55;
      z-index:0;
    }

    .chart-header{
      margin-bottom:8px;
      position:relative;
      z-index:2;
    }
    .chart-title{
      font-size:14px;
      font-weight:800;
      color: rgba(255,255,255,.92);
      text-shadow: 0 0 12px rgba(87,215,255,.18);
    }

    .chart-area{
      position:relative;
      z-index:2; /* keep canvas above overlays */
      flex:1;
      min-height:420px;
    }
    canvas{
      width:100%!important;
      height:100%!important;
      display:block;
    }

    .chart-footer{
      margin-top:12px;
      padding-top:10px;
      border-top:1px solid rgba(87,215,255,.18);
      display:flex;
      justify-content:center;
      gap:10px;
      position:relative;
      z-index:2;
    }

    .footer-label{
      font-size:13px;
      font-weight:700;
      color: rgba(255,255,255,.75);
    }

    select{
      min-width:240px;
      padding:10px 14px;
      font-size:14px;
      border-radius:999px;
      border:1px solid rgba(87,215,255,.25);
      background: rgba(255,255,255,.06);
      color: rgba(255,255,255,.92);
      outline:none;
      box-shadow: 0 0 0 3px rgba(87,215,255,.08);
    }
    select:focus{
      border-color:rgba(87,215,255,.55);
      box-shadow:0 0 0 3px rgba(87,215,255,.16);
    }
    select option{
      background:#0b1220;
      color:white;
    }

    .note{
      margin-top:10px;
      text-align:center;
      font-weight:700;
      color:#ffb4b4;
      display:none;
      font-size:13px;
      position:relative;
      z-index:2;
    }

    .graph-back-nav{
      position:fixed;
      bottom:18px;
      left:50%;
      transform:translateX(-50%);
      z-index:2;
    }
    .graph-back-btn{
      width:130px;
      height:56px;
      background: rgba(255,255,255,.06);
      color: rgba(255,255,255,.92);
      border-radius:50px;
      display:flex;
      align-items:center;
      justify-content:center;
      font-weight:700;
      text-decoration:none;
      border:1px solid rgba(87,215,255,.22);
      box-shadow:
        0 10px 30px rgba(0,0,0,.45),
        0 0 18px rgba(87,215,255,.10);
      backdrop-filter: blur(10px);
    }
  </style>
</head>

<body>
  <h2>Water Consumption by Building (Comparison)</h2>

  <!-- PIPE -->
  <div class="pipeline" aria-hidden="true">
    <div class="pipeline-water">
      <span class="pipe-bubble"></span>
      <span class="pipe-bubble"></span>
      <span class="pipe-bubble"></span>
    </div>
  </div>

  <div class="compare-grid">
    <div class="chart-card">
      <div class="chart-header">
        <div class="chart-title">Compare A</div>
      </div>
      <div class="chart-area">
        <canvas id="buildingChartA"></canvas>
      </div>
      <div class="chart-footer">
        <label class="footer-label" for="buildingSelectA">Building</label>
        <select id="buildingSelectA"></select>
      </div>
      <div class="note" id="msgA"></div>
    </div>

    <div class="chart-card">
      <div class="chart-header">
        <div class="chart-title">Compare B</div>
      </div>
      <div class="chart-area">
        <canvas id="buildingChartB"></canvas>
      </div>
      <div class="chart-footer">
        <label class="footer-label" for="buildingSelectB">Building</label>
        <select id="buildingSelectB"></select>
      </div>
      <div class="note" id="msgB"></div>
    </div>
  </div>

  <div class="graph-back-nav">
    <a href="/" class="graph-back-btn">Back</a>
  </div>

  <!-- DO NOT TOUCH -->
  <script type="module" src="/scripts/plotindivW.js"></script>
</body>
</html>
