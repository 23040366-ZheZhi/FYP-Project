<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Water Consumption Terminal</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --bg: #03070d;
      --panel: #0b1627;
      --border: rgba(90, 220, 255, 0.4);
      --neon: #5adcff;
      --text: #e0f7ff;
    }

    body {
      margin: 0;
      background-color: var(--bg);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow-x: hidden;
    }

    h2 {
      text-transform: uppercase;
      letter-spacing: 4px;
      font-size: 1.2rem;
      margin-bottom: 20px;
      color: var(--neon);
      text-shadow: 0 0 10px rgba(90, 220, 255, 0.5);
    }

    /* ===== THE VERTICAL PIPE ===== */
    .pipeline {
      position: fixed;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 40px;
      height: 100vh;
      background: linear-gradient(90deg, #111 0%, #333 50%, #111 100%);
      border-left: 2px solid rgba(255,255,255,0.1);
      border-right: 2px solid rgba(255,255,255,0.1);
      z-index: 1; /* Sits behind the screens but in the middle gap */
      box-shadow: 0 0 30px rgba(0,0,0,0.8);
    }

    .pipeline-water {
      position: absolute;
      top: 0;
      left: 20%;
      width: 60%;
      height: 100%;
      background: rgba(0, 150, 255, 0.2);
      overflow: hidden;
    }

    /* Flowing Water Effect */
    .pipeline-water::after {
      content: "";
      position: absolute;
      top: -100%;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(to bottom, 
        transparent 0%, 
        rgba(90, 220, 255, 0.4) 50%, 
        transparent 100%);
      animation: waterFlow 3s linear infinite;
    }

    @keyframes waterFlow {
      from { transform: translateY(0); }
      to { transform: translateY(100%); }
    }

    /* ===== LAYOUT GRID ===== */
    .compare-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 100px; /* Space for the pipe to breathe */
      width: 95%;
      max-width: 1400px;
      position: relative;
      z-index: 2; /* Sits above the pipe background */
    }

    /* ===== SCI-FI COMPUTER SCREEN ===== */
    .screen {
      background: rgba(11, 22, 39, 0.85);
      border: 2px solid var(--border);
      border-radius: 10px;
      padding: 20px;
      position: relative;
      box-shadow: 0 0 20px rgba(0, 0, 0, 1), inset 0 0 15px rgba(90, 220, 255, 0.1);
      backdrop-filter: blur(8px);
    }

    /* Screen Bezel Effect */
    .screen::before {
      content: "";
      position: absolute;
      top: -5px; left: -5px; right: -5px; bottom: -5px;
      border: 1px solid rgba(90, 220, 255, 0.2);
      border-radius: 12px;
      pointer-events: none;
    }

    .screen-header {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      padding-bottom: 8px;
      margin-bottom: 15px;
      font-family: monospace;
      font-size: 0.8rem;
    }

    .status-active {
      color: #00ffaa;
      text-shadow: 0 0 5px #00ffaa;
    }

    /* Chart Container - Forced white/light for Chart.js readability */
    .chart-area {
      background: rgba(255, 255, 255, 0.05); /* Dark background for sci-fi look */
      border-radius: 4px;
      height: 350px;
      position: relative;
    }

    /* Footer / Select Styling */
    .screen-footer {
      margin-top: 20px;
      text-align: center;
    }

    select {
      background: #050b14;
      color: var(--neon);
      border: 1px solid var(--border);
      padding: 8px 15px;
      border-radius: 5px;
      cursor: pointer;
      outline: none;
    }

    /* HUD Decorations */
    .bracket {
      position: absolute;
      width: 15px; height: 15px;
      border: 2px solid var(--neon);
    }
    .br-tl { top: -2px; left: -2px; border-right: 0; border-bottom: 0; }
    .br-tr { top: -2px; right: -2px; border-left: 0; border-bottom: 0; }
    .br-bl { bottom: -2px; left: -2px; border-right: 0; border-top: 0; }
    .br-br { bottom: -2px; right: -2px; border-left: 0; border-top: 0; }

    @media (max-width: 950px) {
      .compare-grid { grid-template-columns: 1fr; gap: 40px; }
      .pipeline { display: none; }
    }
  </style>
</head>

<body>

  <h2>System Comparison: Water Infrastructure</h2>

  <div class="pipeline">
    <div class="pipeline-water"></div>
  </div>

  <div class="compare-grid">
    <section class="screen" id="screenA">
      <div class="bracket br-tl"></div><div class="bracket br-tr"></div>
      <div class="bracket br-bl"></div><div class="bracket br-br"></div>

      <div class="screen-header">
        <span>TERMINAL_01 // DATA_FEED</span>
        <span class="status-active">● ONLINE</span>
      </div>

      <div class="chart-area">
        <canvas id="buildingChartA"></canvas>
      </div>

      <div class="screen-footer">
        <select id="buildingSelectA">
            <option>Loading Buildings...</option>
        </select>
      </div>
    </section>

    <section class="screen" id="screenB">
      <div class="bracket br-tl"></div><div class="bracket br-tr"></div>
      <div class="bracket br-bl"></div><div class="bracket br-br"></div>

      <div class="screen-header">
        <span>TERMINAL_02 // COMP_ANALYSIS</span>
        <span class="status-active">● ONLINE</span>
      </div>

      <div class="chart-area">
        <canvas id="buildingChartB"></canvas>
      </div>

      <div class="screen-footer">
        <select id="buildingSelectB">
            <option>Loading Buildings...</option>
        </select>
      </div>
    </section>
  </div>

  <div style="margin-top: 40px; z-index: 10;">
    <a href="/" style="color: var(--neon); text-decoration: none; font-weight: bold; border: 1px solid var(--neon); padding: 10px 20px; border-radius: 20px;">RETURN TO COMMAND</a>
  </div>

  <script type="module" src="/scripts/plotindivW.js"></script>
</body>
</html>