<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Water Consumption by Building</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root{
      --bg1:#020611;
      --bg2:#071a2f;
      --neon:#5adcff;
      --text:#e8fbff;
      --glass: rgba(10, 24, 40, .55);
      --border: rgba(90, 220, 255, .25);
      --shadow: 0 30px 90px rgba(0,0,0,.55);
    }

    body{
      margin:0;
      font-family: Arial, sans-serif;
      color: var(--text);
      min-height: 100vh;
      overflow-x:hidden;
      background:
        radial-gradient(1200px 700px at 50% -10%, rgba(90,220,255,.14), transparent 65%),
        linear-gradient(180deg, var(--bg1), var(--bg2));
    }

    /* ===== SCENE LAYERS ===== */
    .scene{
      position: relative;
      min-height: 100vh;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:flex-start;
      padding: 18px 14px 170px; /* leave space for bottom tank */
    }

    /* Rain layer */
    .rain{
      position: fixed;
      inset: 0;
      pointer-events:none;
      z-index: 0;
      overflow:hidden;
      opacity: .9;
    }

    .drop{
      position:absolute;
      top:-20vh;
      width:2px;
      height: 14vh;
      background: linear-gradient(to bottom, transparent, rgba(90,220,255,.45), transparent);
      filter: blur(.2px);
      animation: fall linear infinite;
    }

    @keyframes fall{
      from{ transform: translateY(0); }
      to{ transform: translateY(140vh); }
    }

    /* ===== CHARTS (REVEAL) ===== */
    .compare-grid{
      width: min(1400px, 95vw);
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
      position: relative;
      z-index: 2;
      margin-top: 10px;
    }
    @media (max-width: 950px){
      .compare-grid{ grid-template-columns: 1fr; }
    }

    .screen{
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow);
      padding: 14px;
      backdrop-filter: blur(12px);
      overflow:hidden;

      /* reveal state */
      opacity: 0;
      transform: translateY(18px) scale(.985);
      filter: blur(1px);
      transition: opacity 900ms ease, transform 900ms cubic-bezier(.2,.9,.2,1), filter 900ms ease;
      pointer-events:none;
    }

    .screen.on{
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
      pointer-events:auto;
    }

    .screen-header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding: 4px 6px 10px;
      border-bottom: 1px solid rgba(90,220,255,.14);
      margin-bottom: 12px;
      font-size: 12px;
      font-weight: 900;
      letter-spacing:.3px;
    }

    .status{
      font-size: 11px;
      font-weight: 900;
      color: rgba(0,255,170,.9);
      text-shadow: 0 0 10px rgba(0,255,170,.25);
    }

    .chart-area{
      height: 360px;
      border-radius: 12px;
      background: rgba(255,255,255,.92); /* keep chart readable */
      overflow:hidden;
    }

    canvas{
      width:100% !important;
      height:100% !important;
      display:block;
    }

    .screen-footer{
      margin-top: 12px;
      padding-top: 10px;
      border-top: 1px solid rgba(90,220,255,.14);
      display:flex;
      justify-content:center;
      gap: 10px;
      align-items:center;
    }

    .footer-label{
      font-size: 12px;
      font-weight: 900;
      color: rgba(255,255,255,.8);
    }

    select{
      min-width: 240px;
      padding: 10px 14px;
      font-size: 14px;
      border-radius: 999px;
      border: 1px solid rgba(90,220,255,.22);
      background: rgba(255,255,255,.06);
      color: rgba(255,255,255,.92);
      outline:none;
    }
    select option{
      background:#0b1220;
      color:#fff;
    }

    /* ===== BOTTOM TANK (NO TEXT) ===== */
    .tank-wrap{
      position: fixed;
      left: 50%;
      transform: translateX(-50%);
      bottom: 92px; /* keep above back button */
      width: min(720px, 94vw);
      z-index: 3;
      pointer-events:none;
    }

    .tank{
      height: 92px;
      border-radius: 18px;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(90,220,255,.25);
      box-shadow: 0 16px 50px rgba(0,0,0,.35);
      overflow:hidden;
      position: relative;
      backdrop-filter: blur(10px);
    }

    .tank::before{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(90deg, rgba(255,255,255,.08), transparent 30%, transparent 70%, rgba(255,255,255,.06));
      pointer-events:none;
    }

    .water{
      position:absolute;
      left:0; right:0;
      bottom:0;
      height: 0%;
      background: linear-gradient(180deg, rgba(90,220,255,.35), rgba(0,140,255,.25));
      transition: height 3.2s ease;
    }

    .water::before{
      content:"";
      position:absolute;
      left:-30%;
      top:-18px;
      width:160%;
      height:36px;
      background: radial-gradient(circle at 50% 50%, rgba(255,255,255,.22), rgba(255,255,255,0) 60%);
      filter: blur(2px);
      opacity:.8;
      animation: surface 2.4s ease-in-out infinite;
    }

    @keyframes surface{
      0%{ transform: translateX(-2%) }
      50%{ transform: translateX(2%) }
      100%{ transform: translateX(-2%) }
    }

    /* ===== BACK BUTTON ===== */
    .graph-back-nav{
      position: fixed;
      bottom: 18px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
    }
    .graph-back-btn{
      width: 150px;
      height: 56px;
      background: rgba(255,255,255,.06);
      color: rgba(255,255,255,.92);
      border-radius: 999px;
      display:flex;
      align-items:center;
      justify-content:center;
      text-decoration:none;
      font-weight:900;
      border:1px solid rgba(90,220,255,.22);
      backdrop-filter: blur(10px);
      box-shadow: 0 12px 30px rgba(0,0,0,.45);
    }
  </style>
</head>

<body>
  <!-- RAIN -->
  <div class="rain" id="rain" aria-hidden="true"></div>

  <div class="scene">
    <!-- CHARTS -->
    <div class="compare-grid">
      <section class="screen" id="screenA">
        <div class="screen-header">
          <span>Graph 1 </span>
          <span class="status">● ONLINE</span>
        </div>

        <div class="chart-area">
          <canvas id="buildingChartA"></canvas>
        </div>

        <div class="screen-footer">
          <label class="footer-label" for="buildingSelectA">Building</label>
          <select id="buildingSelectA"></select>
        </div>

        <div class="note" id="msgA"></div>
      </section>

      <section class="screen" id="screenB">
        <div class="screen-header">
          <span>Graph 2</span>
          <span class="status">● ONLINE</span>
        </div>

        <div class="chart-area">
          <canvas id="buildingChartB"></canvas>
        </div>

        <div class="screen-footer">
          <label class="footer-label" for="buildingSelectB">Building</label>
          <select id="buildingSelectB"></select>
        </div>

        <div class="note" id="msgB"></div>
      </section>
    </div>

    <div class="graph-back-nav">
      <a href="/" class="graph-back-btn">Back</a>
    </div>
  </div>

  <!-- BOTTOM TANK (NO WORDS, NO %) -->
  <div class="tank-wrap" aria-hidden="true">
    <div class="tank">
      <div class="water" id="tankWater"></div>
    </div>
  </div>

  <!-- Story Animation Controller (does NOT touch Chart.js) -->
  <script>
    // Build rain drops (automatic)
    const rain = document.getElementById('rain');
    const DROP_COUNT = 70;
    for(let i=0;i<DROP_COUNT;i++){
      const d = document.createElement('span');
      d.className = 'drop';
      const left = Math.random() * 100;
      const dur = 1.2 + Math.random() * 1.8; // 1.2-3.0s
      const delay = Math.random() * 2.5;
      d.style.left = left + 'vw';
      d.style.animationDuration = dur + 's';
      d.style.animationDelay = delay + 's';
      d.style.opacity = (0.35 + Math.random()*0.55).toFixed(2);
      d.style.height = (8 + Math.random()*18) + 'vh';
      rain.appendChild(d);
    }

    // Fill tank then reveal screens (no % shown)
    const tankWater = document.getElementById('tankWater');
    const screenA = document.getElementById('screenA');
    const screenB = document.getElementById('screenB');

    window.addEventListener('load', () => {
      // Fill tank (visual only)
      tankWater.style.height = '70%';

      // Reveal charts after fill
      setTimeout(() => screenA.classList.add('on'), 2600);
      setTimeout(() => screenB.classList.add('on'), 2900);
    });
  </script>

  <!-- DO NOT TOUCH YOUR CHART SCRIPT -->
  <script type="module" src="/scripts/plotindivW.js"></script>
</body>
</html>
