<!DOCTYPE html>
<html>
<head>
    <title>Edit Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5" style="max-width:400px;">
    <h3>Edit Admin</h3>

    <form method="POST">
        <label>Email</label>
        <input class="form-control" name="email" value="<%= admin.email %>" required>

        <label class="mt-2">Password</label>
        <input class="form-control" name="password" value="<%= admin.password %>" required>

        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" name="twofa"
                <%= admin.twofa_enabled ? 'checked' : '' %>>
            <label class="form-check-label">Enable 2FA</label>
        </div>

        <button class="btn btn-primary w-100 mt-3">Save</button>
    </form>

    <a href="/admins" class="btn btn-secondary w-100 mt-2">Back</a>
</div>

</body>
</html>
