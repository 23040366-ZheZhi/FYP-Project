<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Manage Graph Dataset</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/glass.css">
</head>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<body>

<%- include('partials/navbar.ejs') %>

<div class="container mt-4">

    <!-- PAGE TITLE -->
    <h2 class="text-center mb-2">Manage Graph Dataset</h2>
    <p class="text-center text-muted mb-4">
        Only <strong>one Excel dataset</strong> can be active at a time.
        Uploading a new file will automatically replace the existing dataset.
    </p>

    <!-- CURRENT DATASET -->
    <% if (files.length > 0) { %>
        <div class="card mb-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">Current Dataset</h5>
                    <strong><%= files[0] %></strong>
                </div>

                <button class="btn btn-danger btn-sm"
                        onclick="deleteXlsx('<%= files[0] %>')">
                    Delete
                </button>
            </div>
        </div>
    <% } else { %>
        <div class="alert alert-warning text-center mb-4">
            No Excel dataset uploaded yet.
        </div>
    <% } %>

    <!-- UPLOAD NEW DATASET -->
    <div class="card mb-5">
        <div class="card-body">
            <h5 class="mb-3">Upload New Excel Dataset</h5>

            <form action="/upload-xlsx"
                  method="POST"
                  enctype="multipart/form-data"
                  onsubmit="return confirmReplace()">

                <input type="file"
                       class="form-control mb-3"
                       name="xlsx"
                       accept=".xlsx"
                       required>

                <button class="btn btn-primary w-100">
                    Upload & Replace Dataset
                </button>
            </form>
        </div>
    </div>

    <!-- GRAPH YEAR DISPLAY -->
    <div class="card">
        <div class="card-body">
            <h5 class="mb-3">Graph Year Display</h5>

            <form action="/set-graph-year" method="POST">
                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           name="yearMode"
                           value="current"
                           <%= yearMode === 'current' ? 'checked' : '' %>>
                    <label class="form-check-label">
                        Current Year Only
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           name="yearMode"
                           value="previous"
                           <%= yearMode === 'previous' ? 'checked' : '' %>>
                    <label class="form-check-label">
                        Previous Year Only
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           name="yearMode"
                           value="both"
                           <%= yearMode === 'both' ? 'checked' : '' %>>
                    <label class="form-check-label">
                        Both Years
                    </label>
                </div>

                <button class="btn btn-success mt-3">
                    Save Selection
                </button>
            </form>
        </div>
    </div>

    <!-- GRAPH FORMAT -->
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="mb-3">Graph Format</h5>

            <form action="/set-graph-format" method="POST">
                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           name="graphType"
                           value="bar"
                           <%= (graphType || 'bar') === 'bar' ? 'checked' : '' %>>
                    <label class="form-check-label">
                        Bar Graph
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           name="graphType"
                           value="line"
                           <%= graphType === 'line' ? 'checked' : '' %>>
                    <label class="form-check-label">
                        Line Graph
                    </label>
                </div>

                <button class="btn btn-success mt-3">
                    Save Selection
                </button>
            </form>
        </div>
    </div>

    <!-- ✅ NEW: INDIVIDUAL SETTINGS -->
    <div class="card mt-4 mb-5">
        <div class="card-body">
            <h5 class="mb-3">Individual Graph Settings</h5>

            <form action="/set-individual-settings" method="POST">
                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           name="individualMode"
                           value="interactive"
                           <%= (individualMode || 'interactive') === 'interactive' ? 'checked' : '' %>>
                    <label class="form-check-label">
                        Interactive
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           name="individualMode"
                           value="non-interactive"
                           <%= individualMode === 'non-interactive' ? 'checked' : '' %>>
                    <label class="form-check-label">
                        Non Interactive
                    </label>
                </div>

                <button class="btn btn-success mt-3">
                    Save Selection
                </button>
            </form>
        </div>
    </div>

</div> <!-- END container -->

<script>
function deleteXlsx(filename) {
    if (!confirm(
        "Delete the current dataset?\n\nGraphs will stop working until a new file is uploaded."
    )) return;

    fetch(`/delete-xlsx/${filename}`, { method: "DELETE" })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert("Failed to delete file.");
            }
        });
}

function confirmReplace() {
    return confirm(
        "Uploading a new Excel file will replace the existing dataset.\n\nContinue?"
    );
}
</script>

</body>
</html>
