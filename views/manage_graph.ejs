<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Manage Graph Files</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<%- include("partials/navbar.ejs") %>

<div class="container mt-4">

    <h2 class="text-center mb-4">Manage Graph XLSX Files</h2>

    <!-- EXISTING XLSX FILES -->
    <ul class="list-group mb-4">
        <% files.forEach(file => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <strong><%= file %></strong>

                <button class="btn btn-danger btn-sm"
                        onclick="deleteXlsx('<%= file %>')">
                    Delete
                </button>
            </li>
        <% }) %>
    </ul>

    <!-- UPLOAD NEW XLSX -->
    <h4>Add New XLSX</h4>
    <form action="/upload-xlsx" method="POST" enctype="multipart/form-data">
        <input type="file"
               class="form-control mb-2"
               name="xlsx"
               accept=".xlsx"
               required>

        <button class="btn btn-primary">Upload</button>
    </form>

</div>

<script>
function deleteXlsx(filename) {
    if (!confirm("Delete this XLSX file?")) return;

    fetch(`/delete-xlsx/${filename}`, {
        method: "DELETE"
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert("Failed to delete file.");
        }
    });
}
</script>

</body>
</html>
