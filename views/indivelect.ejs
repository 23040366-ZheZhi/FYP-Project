<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Electricity Consumption Comparison</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --sky: #87ceeb;
      --grass: #22c55e;
      --card-bg: rgba(255, 255, 255, 0.9);
      --text: #111827;
      --turbine-body: #f8fafc;
      --electric-gold: #fbbf24;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(to bottom, #29abe2, var(--sky));
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ===== SUN ===== */
    .sun {
      position: fixed;
      top: 30px;
      left: 40px;
      width: 70px;
      height: 70px;
      background: #fff176;
      border-radius: 50%;
      box-shadow: 0 0 40px #fff176;
      z-index: 1;
      pointer-events: none;
    }

    /* ===== GROUND ===== */
    .horizon {
      position: fixed;
      bottom: 0;
      width: 100%;
      height: 100px;                 
      background: var(--grass);
      z-index: 5;
      border-top: 5px solid #16a34a;
      pointer-events: none;
    }

    /* ===== TURBINES GENERATORS ===== */
    .turbine-farm {
      position: fixed;
      bottom: 100px;                 
      width: 100%;
      display: flex;
      justify-content: space-around;
      align-items: flex-end;
      z-index: 6;
      pointer-events: none;
    }

    .turbine {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    .tower {
      width: 8px;
      height: 180px;
      background: linear-gradient(90deg, #e2e8f0, #cbd5e1);
      clip-path: polygon(30% 0%, 70% 0%, 100% 100%, 0% 100%);
    }

    .blades {
      position: absolute;
      top: -70px;
      width: 140px;
      height: 140px;
      animation: spin var(--speed) linear infinite;
    }

    .blade {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 8px;
      height: 70px;
      background: var(--turbine-body);
      transform-origin: top center;
      border-radius: 0 0 10px 10px;
      box-shadow: inset 2px 0 5px rgba(0,0,0,0.05);
    }

    .blade:nth-child(1) { transform: translate(-50%, 0) rotate(0deg); }
    .blade:nth-child(2) { transform: translate(-50%, 0) rotate(120deg); }
    .blade:nth-child(3) { transform: translate(-50%, 0) rotate(240deg); }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }

    /* ===== GENERATOR BOX ===== */
    .generator {
      position: absolute;
      bottom: -65px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 50px;
      background: #334155;
      border-radius: 6px;
      z-index: 20;
      border: 3px solid #1e293b;
      transition: all 0.8s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .charged {
      background: var(--electric-gold);
      box-shadow: 0 0 30px var(--electric-gold);
      border-color: #d97706;
    }

    .bolt {
      font-size: 20px;
      color: white;
      opacity: 0;
    }

    .charged .bolt {
      opacity: 1;
      animation: flicker 0.5s infinite;
    }

    @keyframes flicker {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* ===== CONTENT ===== */
    .main-container {
      position: relative;
      z-index: 20;
      padding: 20px;
      opacity: 0;
      transform: translateY(30px);
      transition: all 1s ease-out;
    }
    body.ready .main-container {
      opacity: 1;
      transform: translateY(0);
    }

    h2 {
      text-align: center;
      color: white;
      text-shadow: 0 2px 8px rgba(0,0,0,0.2);
      margin: 10px 0 20px;
      font-size: 42px;
      font-weight: 800;
    }

    .compare-grid {
      max-width: 1600px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    @media (max-width: 950px) {
      .compare-grid { grid-template-columns: 1fr; }
    }

    .chart-card {
      background: var(--card-bg);
      border-radius: 14px;
      padding: 15px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      backdrop-filter: blur(8px);
      display: flex;
      flex-direction: column;
      min-height: 500px;
    }

    .chart-header {
      font-size: 14px;
      font-weight: 800;
      margin-bottom: 10px;
    }

    .chart-area {
      position: relative;
      flex: 1;
      min-height: 380px;
    }

    canvas {
      width: 100% !important;
      height: 100% !important;
    }

    .chart-footer {
      margin-top: 15px;
      padding-top: 10px;
      border-top: 1px solid rgba(0,0,0,0.05);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    select {
      min-width: 200px;
      padding: 8px 14px;
      border-radius: 20px;
      border: 1px solid #ddd;
    }

    /* Back button */
    .graph-back-nav {
      position: fixed;
      bottom: 15px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2000;
    }
    .graph-back-btn {
      width: 130px;
      height: 56px;
      background: rgba(17,24,39,.85);
      color: #fff;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-weight: 800;
      box-shadow: 0 12px 30px rgba(0,0,0,.35);
    }
  </style>
</head>

<body>
  <div class="sun"></div>

  <!-- 4 turbines + generators -->
  <div class="turbine-farm">
    <div class="turbine" style="--speed: 3s;">
      <div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div>
      <div class="tower"></div>
      <div class="generator gen1"><span class="bolt">⚡</span></div>
    </div>

    <div class="turbine" style="--speed: 2.6s;">
      <div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div>
      <div class="tower"></div>
      <div class="generator gen2"><span class="bolt">⚡</span></div>
    </div>

    <div class="turbine" style="--speed: 3.6s;">
      <div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div>
      <div class="tower"></div>
      <div class="generator gen3"><span class="bolt">⚡</span></div>
    </div>

    <div class="turbine" style="--speed: 2.9s;">
      <div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div>
      <div class="tower"></div>
      <div class="generator gen4"><span class="bolt">⚡</span></div>
    </div>
  </div>

  <div class="horizon"></div>

  <div class="main-container">
    <h2>Electricity Consumption by Building</h2>

    <div class="compare-grid">
      
      <div class="chart-card">
        <div class="chart-header">Compare A</div>
        <div class="chart-area"><canvas id="buildingChartA"></canvas></div>
        <div class="chart-footer">
          <label for="buildingSelectA">Building</label>
          <select id="buildingSelectA"></select>
        </div>
        <div class="note" id="msgA"></div>
      </div>

      <div class="chart-card">
        <div class="chart-header">Compare B</div>
        <div class="chart-area"><canvas id="buildingChartB"></canvas></div>
        <div class="chart-footer">
          <label for="buildingSelectB">Building</label>
          <select id="buildingSelectB"></select>
        </div>
        <div class="note" id="msgB"></div>
      </div>
    </div>
  </div>

  <div class="graph-back-nav">
    <a href="/" class="graph-back-btn">Back</a>
  </div>

  <script>
    
    window.addEventListener("load", () => {
      setTimeout(() => {
        document.querySelector(".gen1").classList.add("charged");
        document.querySelector(".gen2").classList.add("charged");
        document.querySelector(".gen3").classList.add("charged");
        document.querySelector(".gen4").classList.add("charged");
      }, 900);

      setTimeout(() => {
        document.body.classList.add("ready");
      }, 1800);
    });
  </script>


  <script type="module" src="/scripts/plotindividual.js"></script>
</body>
</html>
