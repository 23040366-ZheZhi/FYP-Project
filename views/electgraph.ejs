<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Electricity Usage</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --sky: #87ceeb;
      --grass: #22c55e;
      --turbine-body: #f8fafc;
      --electric-gold: #fbbf24;
    }

    body, html {
      margin: 0; padding: 0;
      height: 100vh; width: 100vw;
      overflow-x: hidden;
      font-family: Arial, sans-serif;
      background: linear-gradient(to bottom, #29abe2, var(--sky));
    }

    /* BACKGROUND */
    .sun {
      position: absolute; top: 30px; left: 50px;
      width: 80px; height: 80px;
      background: #fff176; border-radius: 50%;
      box-shadow: 0 0 50px #fff176;
      z-index: 1;
    }

    
    .horizon {
      position: fixed;
      bottom: 0;
      width: 100%;
      height: 140px;              
      background: var(--grass);
      z-index: 5;
      border-top: 5px solid #16a34a;
    }

    
    .turbine-farm {
      position: fixed;
      bottom: 140px;              
      width: 100%;
      display: flex;
      justify-content: space-around;
      align-items: flex-end;
      z-index: 6;
      pointer-events: none;
    }

    .turbine {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    .tower {
      width: 8px;
      height: 180px;
      background: linear-gradient(90deg, #e2e8f0, #cbd5e1);
      clip-path: polygon(30% 0%, 70% 0%, 100% 100%, 0% 100%);
    }

    .blades {
      position: absolute;
      top: -70px;
      width: 140px;
      height: 140px;
      animation: spin var(--speed) linear infinite;
    }

    .blade {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 8px;
      height: 70px;
      background: var(--turbine-body);
      transform-origin: top center;
      border-radius: 0 0 10px 10px;
      box-shadow: inset 2px 0 5px rgba(0,0,0,0.05);
    }

    .blade:nth-child(1) { transform: translate(-50%, 0) rotate(0deg); }
    .blade:nth-child(2) { transform: translate(-50%, 0) rotate(120deg); }
    .blade:nth-child(3) { transform: translate(-50%, 0) rotate(240deg); }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* GENERATOR */
    .generator {
      position: absolute;
      bottom: -65px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 50px;
      background: #334155;
      border-radius: 6px;
      z-index: 20;
      border: 3px solid #1e293b;
      transition: all 0.8s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .charged {
      background: var(--electric-gold);
      box-shadow: 0 0 30px var(--electric-gold);
      border-color: #d97706;
    }

    .bolt {
      font-size: 20px;
      color: white;
      opacity: 0;
    }

    .charged .bolt {
      opacity: 1;
      animation: flicker 0.5s infinite;
    }

    @keyframes flicker {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* CONTENT */
    .content {
      position: relative;
      z-index: 20;
      max-width: 1050px;
      margin: 0 auto;
      padding: 60px 15px;
      text-align: center;

      opacity: 0;
      transform: translateY(50px);
      transition: all 1s ease-out;
    }

    .ready .content {
      opacity: 1;
      transform: translateY(0);
    }

    .chart-wrap {
      background: rgba(255, 255, 255, 0.9);
      border-radius: 18px;
      padding: 18px;
      box-shadow: 0 24px 90px rgba(0,0,0,0.1);
      backdrop-filter: blur(10px);
    }

   h2 {
  color: #fff;
  text-shadow: 0 2px 10px rgba(0,0,0,0.3);
  margin-bottom: 20px;
  font-weight: 800;
  font-size: 42px;  
}


    /* Back button */
    .graph-back-nav {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2000;
      display: flex;
      justify-content: center;
    }

    .graph-back-btn {
      width: 120px;
      height: 60px;
      background: #343a40;
      color: white;
      border-radius: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
      transition: 0.2s ease;
      box-shadow: 0 12px 28px rgba(0,0,0,.18);
    }

    .graph-back-btn:hover {
      background: #23272b;
    }
  </style>
</head>

<body>
  <div class="sun"></div>

  <div class="turbine-farm">
    <div class="turbine" style="--speed: 3s;">
      <div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div>
      <div class="tower"></div>
      <div class="generator gen1"><span class="bolt">⚡</span></div>
    </div>

    <div class="turbine" style="--speed: 2.5s; transform: scale(1.2);">
      <div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div>
      <div class="tower"></div>
      <div class="generator gen2"><span class="bolt">⚡</span></div>
    </div>

    <div class="turbine" style="--speed: 4s;">
      <div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div>
      <div class="tower"></div>
      <div class="generator gen3"><span class="bolt">⚡</span></div>
    </div>
  </div>

  <div class="horizon"></div>

  <div class="content">
    <h2>Whole Campus Electricity Usage (kWh)</h2>
    
    <div class="chart-wrap">
      <canvas id="electricChart"></canvas>
    </div>
  </div>

  
  <div class="graph-back-nav">
    <a href="/" class="graph-back-btn">Back</a>
  </div>

  <script>
    window.addEventListener('load', () => {
      setTimeout(() => {
        document.querySelector('.gen1').classList.add('charged');
        document.querySelector('.gen2').classList.add('charged');
        document.querySelector('.gen3').classList.add('charged');
      }, 1000);

      setTimeout(() => document.body.classList.add('ready'), 2000);
    });
  </script>

  <script type="module" src="/scripts/plotelect.js"></script>
  <script>
    window.ROTATE_CFG = JSON.stringify(window.rotateCfg || {});
  </script>
  <script src="/scripts/idle-rotate.js"></script>
</body>
</html>
