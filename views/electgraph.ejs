<style>
  :root {
    --night1: #020617;
    --night2: #0b1022;
    --electric-blue: #00d4ff;
    --blade-color: #e2e8f0;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(180deg, var(--night1), var(--night2));
    color: #fff;
    overflow: hidden;
    height: 100vh;
  }

  /* ===== BACKGROUND SCENE ===== */
  .energy-farm {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
    padding-bottom: 50px;
    background: radial-gradient(circle at 50% 100%, #1e293b 0%, transparent 70%);
  }

  /* ===== WIND TURBINE DESIGN ===== */
  .turbine {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: scale(0.8);
    opacity: 0.6;
  }

  .turbine.large { transform: scale(1.2); opacity: 0.8; z-index: 2; }

  .tower {
    width: 12px;
    height: 300px;
    background: linear-gradient(90deg, #94a3b8, #cbd5e1);
    clip-path: polygon(30% 0%, 70% 0%, 100% 100%, 0% 100%);
  }

  .blades {
    position: absolute;
    top: -50px;
    width: 200px;
    height: 200px;
    animation: spin var(--speed) linear infinite;
  }

  .blade {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 90px;
    background: var(--blade-color);
    transform-origin: top center;
    border-radius: 50% 50% 20% 20%;
  }

  .blade:nth-child(1) { transform: translate(-50%, 0) rotate(0deg); }
  .blade:nth-child(2) { transform: translate(-50%, 0) rotate(120deg); }
  .blade:nth-child(3) { transform: translate(-50%, 0) rotate(240deg); }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ===== GENERATOR & CHARGE ===== */
  .generator-hub {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 80px;
    background: #334155;
    border-radius: 10px 10px 0 0;
    z-index: 3;
    border-top: 4px solid var(--electric-blue);
    box-shadow: 0 0 0px var(--electric-blue);
    transition: box-shadow 2s ease-in-out;
  }

  .charging .generator-hub {
    box-shadow: 0 -10px 50px var(--electric-blue);
  }

  /* ===== CONTENT / GRAPH REVEAL ===== */
  .content {
    position: relative;
    z-index: 10;
    max-width: 1000px;
    margin: 0 auto;
    padding-top: 5vh;
    text-align: center;
    opacity: 0;
    transform: translateY(30px) scale(0.95);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ready .content {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .chart-wrap {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }
</style>

<body>
  <div class="energy-farm">
    <div class="turbine" style="--speed: 4s;">
      <div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div>
      <div class="tower"></div>
    </div>
    <div class="turbine large" style="--speed: 3s;">
      <div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div>
      <div class="tower"></div>
    </div>
    <div class="turbine" style="--speed: 5s;">
      <div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div>
      <div class="tower"></div>
    </div>
  </div>

  <div class="generator-hub"></div>

  <div class="content" id="mainContent">
    <h2 style="text-shadow: 0 4px 10px rgba(0,0,0,0.8);">Campus Electricity Usage</h2>
    <div class="chart-wrap">
      <canvas id="electricChart"></canvas>
    </div>
  </div>

  <script>
    // Sequence Logic
    window.addEventListener('load', () => {
      const body = document.body;
      
      // 1. Start "Charging" the generator immediately
      setTimeout(() => {
        body.classList.add('charging');
      }, 500);

      // 2. Show the graph after 2.5 seconds of "charging"
      setTimeout(() => {
        body.classList.add('ready');
      }, 2500);
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script type="module" src="/scripts/plotelect.js"></script>
</body>