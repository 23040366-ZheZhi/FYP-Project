<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Electricity Usage</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root{
      --night1:#020617;
      --night2:#0b1022;

      --card: rgba(255,255,255,.86);
      --cardBorder: rgba(255,255,255,.32);
      --text:#0b1220;
    }

    *{ box-sizing:border-box; }
    body{
      margin:0;
      font-family: Arial, sans-serif;
      color: var(--text);
      overflow-x:hidden;
      overflow-y:auto;
      background: linear-gradient(180deg, var(--night1), var(--night2));
    }

    /* ===== Stage / background ===== */
    .stage{
      position: relative;
      min-height: 100vh;
      overflow:hidden;
      isolation: isolate;
    }

    /* Night sky */
    .sky{
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 20% 15%, rgba(255,255,255,.07), transparent 35%),
        radial-gradient(circle at 70% 20%, rgba(255,255,255,.06), transparent 38%),
        linear-gradient(180deg, #020617, #0b1022 70%, #0b1022);
      z-index: 0;
    }

    /* stars */
    .stars{
      position: fixed;
      inset: 0;
      z-index: 1;
      pointer-events:none;
      opacity: .35;
      background-image:
        radial-gradient(circle, rgba(255,255,255,.9) 1px, transparent 1px),
        radial-gradient(circle, rgba(255,255,255,.7) 1px, transparent 1px),
        radial-gradient(circle, rgba(255,255,255,.6) 1px, transparent 1px);
      background-size: 220px 220px, 280px 280px, 360px 360px;
      background-position: 0 0, 80px 40px, 140px 120px;
      filter: blur(.2px);
    }

    /* Moon top right */
    .moon{
      position: fixed;
      top: 34px;
      right: 34px;
      width: 74px;
      height: 74px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 35% 35%, rgba(255,255,255,.98), rgba(230,240,255,.92) 55%, rgba(205,220,255,.88) 100%);
      box-shadow: 0 0 30px rgba(255,255,255,.25);
      z-index: 3;
      pointer-events:none;
    }
    .moon::after{
      content:"";
      position:absolute;
      inset: -10px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,255,255,.20), transparent 60%);
      filter: blur(4px);
    }

    /* Soft spotlight behind chart */
    .spotlight{
      position: fixed;
      inset: 0;
      z-index: 2;
      pointer-events:none;
      background:
        radial-gradient(circle at 50% 35%, rgba(255,255,255,.08), transparent 55%),
        radial-gradient(circle at 50% 55%, rgba(255,216,77,.06), transparent 58%);
    }

    /* ===== Content ===== */
    .content{
      position: relative;
      z-index: 10;
      max-width: 1200px;
      margin: 0 auto;
      padding: 80px 12px 110px;
      text-align:center;
    }

    h2{
      margin: 0 0 14px;
      color: rgba(255,255,255,.92);
      text-shadow: 0 10px 28px rgba(0,0,0,.45);
      letter-spacing:.2px;
      font-weight: 800;
    }

    .chart-wrap{
      max-width: 1050px;
      margin: 0 auto;
      background: var(--card);
      border: 1px solid var(--cardBorder);
      border-radius: 18px;
      padding: 18px;
      box-shadow:
        0 24px 90px rgba(0,0,0,.45),
        0 0 0 1px rgba(255,255,255,.05) inset;
      backdrop-filter: blur(10px);
      position: relative;
      z-index: 20;
    }

    canvas{ width:100% !important; height:450px !important; }

    /* Back button */
    .graph-back-nav{
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 30;
      display:flex;
      justify-content:center;
    }
    .graph-back-btn{
      width: 120px;
      height: 60px;
      background: rgba(17,24,39,.88);
      color: #fff;
      border-radius: 999px;
      display:flex;
      align-items:center;
      justify-content:center;
      text-decoration:none;
      font-size:14px;
      box-shadow: 0 12px 28px rgba(0,0,0,.22);
      transition: transform .18s ease, background .18s ease;
    }
    .graph-back-btn:hover{
      background: rgba(17,24,39,.95);
      transform: translateY(-1px);
    }

    /* =====================================================
       ✅ REALISTIC 3D-LIKE SKYLINE (BEHIND THE GRAPH)
       Covers ~70-80% of page height, sits behind chart.
       ===================================================== */
    .skyline{
      position: fixed;
      left: 0; right: 0;
      bottom: 0;
      height: 78vh;              /* BIG (good for tall monitor) */
      min-height: 720px;
      z-index: 6;                /* behind chart (chart is 20), above sky */
      pointer-events: none;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: clamp(18px, 2.4vw, 50px);
      padding: 0 clamp(24px, 5vw, 120px) clamp(40px, 6vh, 140px);
      overflow: hidden;
    }

    /* haze/fog so buildings look “in the scene” */
    .skyline::before{
      content:"";
      position:absolute;
      left:0; right:0; top:-15vh;
      height: 70vh;
      background:
        radial-gradient(circle at 50% 30%,
          rgba(255,255,255,.08),
          rgba(2,6,23,.55) 58%,
          rgba(2,6,23,.92) 100%);
      z-index: 0;
    }

    .bldg{
      --w: 280px;
      --h: 780px;
      --d: 56px; /* depth */
      width: var(--w);
      height: var(--h);
      position: relative;
      transform: translateZ(0);
      z-index: 1;
      filter: drop-shadow(0 40px 100px rgba(0,0,0,.75));
    }

    /* front face (more “model” grey like your reference) */
    .bldg .front{
      position:absolute;
      inset: 0;
      border-radius: 14px;
      background:
        linear-gradient(180deg,
          rgba(255,255,255,.22),
          rgba(255,255,255,.12) 28%,
          rgba(255,255,255,.10) 60%,
          rgba(0,0,0,.18) 100%),
        linear-gradient(90deg,
          rgba(255,255,255,.10),
          rgba(255,255,255,.05) 35%,
          rgba(0,0,0,.10) 100%);
      border: 1px solid rgba(255,255,255,.12);
      box-shadow:
        inset 0 0 0 1px rgba(0,0,0,.28),
        inset 0 14px 30px rgba(255,255,255,.06);
    }

    /* side face */
    .bldg::after{
      content:"";
      position:absolute;
      top: 10px;
      right: calc(var(--d) * -1);
      width: var(--d);
      height: calc(100% - 20px);
      border-radius: 0 12px 12px 0;
      background:
        linear-gradient(180deg,
          rgba(255,255,255,.10),
          rgba(0,0,0,.28)),
        linear-gradient(90deg,
          rgba(0,0,0,.18),
          rgba(0,0,0,.55));
      border: 1px solid rgba(255,255,255,.08);
      transform: skewY(-10deg);
      transform-origin: left top;
    }

    /* roof lip */
    .bldg .roof{
      position:absolute;
      left: 10px;
      right: calc(var(--d) + 10px);
      top: -10px;
      height: 22px;
      border-radius: 12px;
      background: linear-gradient(180deg,
        rgba(255,255,255,.20),
        rgba(0,0,0,.18));
      border: 1px solid rgba(255,255,255,.10);
      box-shadow: 0 14px 22px rgba(0,0,0,.35);
    }

    /* window strips */
    .bldg .strip{
      position:absolute;
      left: 16px;
      right: calc(var(--d) + 18px);
      height: 86px;
      border-radius: 10px;
      background: rgba(0,0,0,.26);
      border: 1px solid rgba(255,255,255,.08);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,.38);
      overflow: hidden;
    }

    /* “holes” grid */
    .bldg .strip::before{
      content:"";
      position:absolute;
      inset: 12px 14px;
      background:
        repeating-linear-gradient(90deg,
          rgba(255,255,255,.14) 0 2px,
          transparent 2px 12px),
        repeating-linear-gradient(180deg,
          rgba(255,255,255,.14) 0 2px,
          transparent 2px 12px);
      opacity: .55;
      filter: blur(.2px);
    }

    /* subtle lit rooms (NOT pixel look) */
    .bldg .strip::after{
      content:"";
      position:absolute;
      inset: 12px 14px;
      background:
        radial-gradient(circle at 22% 35%, rgba(255,216,77,.60), transparent 32%),
        radial-gradient(circle at 72% 60%, rgba(255,216,77,.55), transparent 34%),
        radial-gradient(circle at 46% 78%, rgba(255,216,77,.45), transparent 30%);
      opacity: .22;
    }

    /* entrance */
    .bldg .entrance{
      position:absolute;
      left: 18px;
      bottom: 18px;
      width: 46%;
      height: 96px;
      border-radius: 12px;
      background: rgba(0,0,0,.28);
      border: 1px solid rgba(255,255,255,.10);
      overflow:hidden;
    }
    .bldg .entrance::before{
      content:"";
      position:absolute;
      inset: 14px;
      border-radius: 8px;
      background:
        linear-gradient(90deg, rgba(255,255,255,.10), rgba(255,255,255,.03)),
        repeating-linear-gradient(90deg, rgba(255,255,255,.12) 0 2px, transparent 2px 16px);
      opacity: .65;
    }

    /* Sizes (7 buildings = +2 extra) */
    .bA{ --w: 260px; --h: 760px; --d: 52px; }
    .bB{ --w: 320px; --h: 980px; --d: 62px; }
    .bC{ --w: 240px; --h: 720px; --d: 48px; }
    .bD{ --w: 400px; --h: 1040px; --d: 72px; }
    .bE{ --w: 300px; --h: 900px; --d: 58px; }
    .bF{ --w: 270px; --h: 820px; --d: 54px; }
    .bG{ --w: 340px; --h: 1000px; --d: 64px; }

    /* keep skyline behind chart on small screens too */
    @media (max-width: 980px){
      .skyline{
        height: 62vh;
        min-height: 520px;
        gap: 18px;
        padding: 0 18px 60px;
        opacity: .95;
      }
      canvas{ height: 380px !important; }
    }

    @media (prefers-reduced-motion: reduce){
      *{ scroll-behavior: auto !important; }
    }
  </style>
</head>

<body>
  <div class="stage" id="stage">
    <div class="sky"></div>
    <div class="stars"></div>
    <div class="spotlight"></div>
    <div class="moon" aria-hidden="true"></div>

    <!-- ✅ REALISTIC SKYLINE (behind the graph, covers ~70%+) -->
    <div class="skyline" aria-hidden="true">
      <div class="bldg bA">
        <div class="roof"></div><div class="front"></div>
        <div class="strip" style="top:120px;"></div>
        <div class="strip" style="top:255px;"></div>
        <div class="strip" style="top:390px;"></div>
        <div class="strip" style="top:525px;"></div>
        <div class="entrance"></div>
      </div>

      <div class="bldg bB">
        <div class="roof"></div><div class="front"></div>
        <div class="strip" style="top:160px;"></div>
        <div class="strip" style="top:310px;"></div>
        <div class="strip" style="top:460px;"></div>
        <div class="strip" style="top:610px;"></div>
        <div class="strip" style="top:760px;"></div>
        <div class="entrance"></div>
      </div>

      <div class="bldg bC">
        <div class="roof"></div><div class="front"></div>
        <div class="strip" style="top:140px;"></div>
        <div class="strip" style="top:290px;"></div>
        <div class="strip" style="top:440px;"></div>
        <div class="entrance"></div>
      </div>

      <div class="bldg bD">
        <div class="roof"></div><div class="front"></div>
        <div class="strip" style="top:170px;"></div>
        <div class="strip" style="top:330px;"></div>
        <div class="strip" style="top:490px;"></div>
        <div class="strip" style="top:650px;"></div>
        <div class="strip" style="top:810px;"></div>
        <div class="entrance"></div>
      </div>

      <div class="bldg bE">
        <div class="roof"></div><div class="front"></div>
        <div class="strip" style="top:150px;"></div>
        <div class="strip" style="top:300px;"></div>
        <div class="strip" style="top:450px;"></div>
        <div class="strip" style="top:600px;"></div>
        <div class="entrance"></div>
      </div>

      <!-- +2 extra buildings -->
      <div class="bldg bF">
        <div class="roof"></div><div class="front"></div>
        <div class="strip" style="top:140px;"></div>
        <div class="strip" style="top:290px;"></div>
        <div class="strip" style="top:440px;"></div>
        <div class="strip" style="top:590px;"></div>
        <div class="entrance"></div>
      </div>

      <div class="bldg bG">
        <div class="roof"></div><div class="front"></div>
        <div class="strip" style="top:165px;"></div>
        <div class="strip" style="top:325px;"></div>
        <div class="strip" style="top:485px;"></div>
        <div class="strip" style="top:645px;"></div>
        <div class="strip" style="top:805px;"></div>
        <div class="entrance"></div>
      </div>
    </div>

    <div class="content">
      <h2>Whole Campus Electricity Usage (kWh)</h2>

      <div class="chart-wrap">
        <canvas id="electricChart"></canvas>
      </div>

      <div class="msg" id="msgBox" style="display:none;"></div>
    </div>

    <div class="graph-back-nav">
      <a href="/" class="graph-back-btn">Back</a>
    </div>

    <!-- Your existing chart logic (UNCHANGED) -->
    <script type="module" src="/scripts/plotelect.js"></script>
    <script>
      window.ROTATE_CFG = <%- JSON.stringify(rotateCfg || {}) %>;
      console.log(window.__ROTATE_CFG__);
    </script>
    <script src="/scripts/idle-rotate.js"></script>
  </div>
</body>
</html>
