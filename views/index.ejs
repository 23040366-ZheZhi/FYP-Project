<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <title>ESG Centre Dashboard</title>

<style>
  html, body {
    background: url('/images/gay1.png') no-repeat center center fixed;
    background-size: cover;
    image-rendering: optimizeQuality;
  }
</style>

<style>
body {
    background-image: url("/images/gay.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
}
</style>

<style>
  /* Snapshot Cards */
  .mini-dashboard { margin: 40px 0; }
  .mini-card {
    background: #fff;
    border-radius: 16px;
    padding: 18px 20px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    cursor: pointer;
    transition: 0.2s ease;
  }
  .mini-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0,0,0,0.12);
  }
  .mini-value { font-size: 1.4rem; font-weight: 600; margin-bottom: 8px; }
  .mini-card canvas { height: 110px !important; }

  /* Carousel */
  .carousel-item { height: 450px; }
  .game-image { width: 100%; height: 100%; object-fit: cover; }

  /* Map */
  img#rpmapImg { width: 100%; max-width: 900px; }

</style>
<script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>

</head>

<body>

  <!-- TOP NAVBAR -->
  <%- include('partials/navbar.ejs') %>

  <!-- RP LOGO -->
  <img src="/images/rp.png" class="mx-auto d-block mt-3" style="width: 360px; height:auto; margin-bottom: 50px;">  


  <!-- SNAPSHOT SECTION -->
  <div class="container mt-4">
    <h2 class="text-center mb-4">Campus Performance Snapshot</h2>

    <div class="row g-4 mini-dashboard">

      <!-- ENERGY -->
      <div class="col-md-4">
        <div class="mini-card" onclick="window.location.href='/electgraph'">
          <h5>Energy</h5>
          <div id="miniEnergyValue">Loading...</div>
          <canvas id="miniEnergyChart"></canvas>
        </div>
      </div>

      <!-- SOLAR -->
      <div class="col-md-4">
        <div class="mini-card" onclick="window.location.href='/solargraph'">
          <h5>Solar</h5>
          <div id="miniSolarValue">Loading...</div>
          <canvas id="miniSolarChart"></canvas>
        </div>
      </div>

      <!-- WATER -->
      <div class="col-md-4">
        <div class="mini-card" onclick="window.location.href='/watergraph'">
          <h5>Water</h5>
          <div id="miniWaterValue">Loading...</div>
          <canvas id="miniWaterChart"></canvas>
        </div>
      </div>

    </div>
  </div>

  <!-- CAROUSEL -->
  <div class="carousel-container container mt-4">
    <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">

      <div class="carousel-inner">
        <% games.forEach((game, index) => { %>
          <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
            <video class="d-block w-100 game-image" autoplay loop muted playsinline>
              <source src="/videos/<%= game.image %>" type="video/mp4">
            </video>
          </div>
        <% }) %>
      </div>

    </div>
  </div>

<div class="container mt-5 text-center">
  <h2 class="mb-3">Interactive 3D Campus Map</h2>

  <model-viewer 
      src="/models/campus.glb"
      camera-controls
      rotation-per-second="20deg"
      shadow-intensity="1"
      exposure="1.2"
      environment-image="neutral"
      style="width: 100%; height: 600px; border-radius: 20px; background: #f9f9f9;">
  </model-viewer>
</div>



  <!-- MAP AREA -->
  <div class="container text-center mt-5" style="margin-bottom: 120px;">
    <h2>Select a Building</h2>
    <img id="rpmapImg" src="/images/rpmap.png" usemap="#rpmap">

    <map name="rpmap">

      <area alt="E1" shape="rect" coords="452,585,512,652" onclick="openMenu('E1')">
      <area alt="E2" shape="rect" coords="594,612,530,541" onclick="openMenu('E2')">
      <area alt="E3" shape="rect" coords="451,488,512,559" onclick="openMenu('E3')">
      <area alt="E4" shape="rect" coords="530,451,593,519" onclick="openMenu('E4')">
      <area alt="E5" shape="rect" coords="531,342,596,412" onclick="openMenu('E5')">
      <area alt="E6" shape="rect" coords="448,299,514,370" onclick="openMenu('E6')">

      <area alt="W1" shape="rect" coords="373,642,434,710" onclick="openMenu('W1')">
      <area alt="W2" shape="rect" coords="291,574,350,640" onclick="openMenu('W2')">
      <area alt="W3" shape="rect" coords="291,489,350,557" onclick="openMenu('W3')">
      <area alt="W4" shape="rect" coords="374,465,434,535" onclick="openMenu('W4')">
      <area alt="W5" shape="rect" coords="291,393,351,459" onclick="openMenu('W5')">
      <area alt="W6" shape="rect" coords="371,343,431,411" onclick="openMenu('W6')">

    </map>
  </div>




  <!-- FLOATING BOTTOM NAV -->
  <%- include('partials/bottomnav.ejs') %>



<script>
  function openMenu(buildingId) {
    alert("You clicked " + buildingId);
    console.log("Clicked:", buildingId);
  }


  function createMiniChart(id, data, color) {
    const ctx = document.getElementById(id);
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: data.map((_, i) => i + 1),
        datasets: [{
          data: data,
          borderColor: color,
          backgroundColor: 'transparent',
          tension: 0.3,
          pointRadius: 0
        }]
      },
      options: {
        plugins: { legend: { display: false }},
        scales: { x: { display: false }, y: { display: false } }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {

    fetch(window.location.origin + "/api/summary")
      .then(res => res.json())
      .then(data => {
        const energy = data.energy;
        const solar = data.solar;
        const water = data.water;

        document.getElementById("miniEnergyValue").textContent =
          energy[energy.length-1].toLocaleString() + " kWh";

        document.getElementById("miniSolarValue").textContent =
          solar[solar.length-1].toLocaleString() + " kWp";

        document.getElementById("miniWaterValue").textContent =
          water[water.length-1].toLocaleString() + " m³";

        createMiniChart("miniEnergyChart", energy, "#ffc107");
        createMiniChart("miniSolarChart", solar, "orangered");
        createMiniChart("miniWaterChart", water, "#007bff");
      });

        document.getElementById("miniEnergyValue").textContent = energy[energy.length-1] + " kWh";
        document.getElementById("miniSolarValue").textContent = solar[solar.length-1] + " kWp";
        document.getElementById("miniWaterValue").textContent = water[water.length-1] + " m³";

        createMiniChart("miniEnergyChart", energy, "#ffc107");
        createMiniChart("miniSolarChart", solar, "orangered");
        createMiniChart("miniWaterChart", water, "#007bff");
      });

</script>

</body>
</html>


