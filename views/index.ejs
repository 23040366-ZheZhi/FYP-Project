<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <link rel="stylesheet" href="/stylesheets/glass.css">
  <title>ESG Centre Dashboard</title>

  <style>
    body {
      background-image: url("/images/drew-saurus-unsplash.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }

    .mini-dashboard {
      margin: 40px auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      max-width: 1400px;
      justify-content: center;
      gap: 24px;
    }

    .mini-card {
      border-radius: 22px;
      padding: 22px 24px;
      cursor: pointer;
      min-height: 240px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .mini-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 30px rgba(0,0,0,0.4);
    }

    .mini-card h5 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .mini-value {
      font-size: 2.4rem;
      font-weight: 800;
      margin-bottom: 10px;
    }

    .mini-card canvas {
      height: 190px !important;
    }

    .carousel-item {
      height: 600px;
    }

    .video-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    img#rpmapImg {
      width: 100%;
      max-width: 900px;
    }
  </style>

  <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
</head>

<body>

  <%- include('partials/navbar.ejs') %>

  <div class="container mt-4 text-center">
    <h2 class="glass glass-heading mb-4">Monthly Trend (Last 6 Months)</h2>

    <div class="mini-dashboard">

      <div class="mini-card glass" onclick="window.location.href='/electgraph'">
        <h5>Monthly Energy Usage</h5>
        <div id="miniEnergyValue" class="mini-value">Loading...</div>
        <canvas id="miniEnergyChart"></canvas>
      </div>

      <div class="mini-card glass" onclick="window.location.href='/solargraph'">
        <h5>Monthly Solar Energy Generated</h5>
        <div id="miniSolarValue" class="mini-value">Loading...</div>
        <canvas id="miniSolarChart"></canvas>
      </div>

      <div class="mini-card glass" onclick="window.location.href='/watergraph'">
        <h5>Monthly Water Usage</h5>
        <div id="miniWaterValue" class="mini-value">Loading...</div>
        <canvas id="miniWaterChart"></canvas>
      </div>

      <div class="mini-card glass" onclick="window.location.href='/waste'">
        <h5>Monthly Waste Disposed</h5>
        <div id="miniWasteValue" class="mini-value">Loading...</div>
        <canvas id="miniWasteChart"></canvas>
      </div>


      <div class="mini-card glass">
        <h5>Peak Monthly Energy (Last 6)</h5>
        <div id="miniEnergyPeak" class="mini-value">Loading...</div>
        <p>Highest month in the last 6 months</p>
      </div>

      <div class="mini-card glass">
        <h5>Peak Monthly Solar (Last 6)</h5>
        <div id="miniSolarPeak" class="mini-value">Loading...</div>
        <p>Highest month in the last 6 months</p>
      </div>

      <div class="mini-card glass">
        <h5>Peak Monthly Water (Last 6)</h5>
        <div id="miniWaterPeak" class="mini-value">Loading...</div>
        <p>Highest month in the last 6 months</p>
      </div>

      <div class="mini-card glass">
        <h5>Peak Monthly Waste (Last 6)</h5>
        <div id="miniWastePeak" class="mini-value">Loading...</div>
        <p>Highest month in the last 6 months</p>
      </div>

    </div>
  </div>


  <div class="carousel-container container mt-4">
    <div id="productCarousel" class="carousel slide">
      <div class="carousel-inner">
        <% videos.forEach((video, index) => { %>
          <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
            <video class="d-block w-100 video-video" playsinline muted controls>
              <source src="/videos/<%= video.video %>" type="video/mp4">
            </video>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="container mt-5 text-center">
    <h2 class="glass glass-heading mb-3">Interactive 3D Campus Map</h2>

    <model-viewer
      id="campusModel"
      src="/models/campuss.glb"
      camera-controls
      auto-rotate
      environment-image="neutral"
      interaction-prompt="none"
      touch-action="none"
      shadow-intensity="1"
      exposure="0.5"
      style="width:100%;height:600px;background:#fff;border-radius:20px;">
    </model-viewer>
  </div>

  <%- include('partials/bottomnav.ejs') %>

  

<!-- index.ejs — REPLACE your entire bottom <script> block with this
Changes:
1) X axis shows all 6 months, slanted labels to fit.
2) Solar chart does NOT plot 0 or negative values (they become null).
3) Solar “Latest” value falls back to last positive month (so it will not show 0).
-->

<script>
/* =======================
   HELPERS
======================= */

function lastValidIndexAny(values) {
  if (!Array.isArray(values) || values.length === 0) return -1;
  for (let i = values.length - 1; i >= 0; i--) {
    const n = Number(values[i]);
    if (Number.isFinite(n)) return i; // includes 0 and negatives
  }
  return -1;
}

function lastValidIndexPositive(values) {
  if (!Array.isArray(values) || values.length === 0) return -1;
  for (let i = values.length - 1; i >= 0; i--) {
    const n = Number(values[i]);
    if (Number.isFinite(n) && n > 0) return i; // strictly > 0
  }
  return -1;
}

function pickLatestDisplay(labels, values, mode) {
  const idx = mode === "positive" ? lastValidIndexPositive(values) : lastValidIndexAny(values);
  if (idx < 0) return { label: "", value: 0, idx: -1 };
  return { label: labels[idx] ?? "", value: Number(values[idx]), idx };
}

function toPlottable(values, mode) {
  // Chart.js: null breaks the line and prevents plotting
  if (mode !== "positive") return values.map(v => (Number.isFinite(Number(v)) ? Number(v) : null));
  return values.map(v => {
    const n = Number(v);
    if (!Number.isFinite(n)) return null;
    if (n <= 0) return null; // hide 0 and negatives
    return n;
  });
}

function maxPositive(values) {
  const arr = (values || []).map(Number).filter(n => Number.isFinite(n) && n > 0);
  if (arr.length === 0) return 0;
  return Math.max(...arr);
}

/* =======================
   CHART BACKGROUND
======================= */

const chartBgPlugin = {
  id: "chartBg",
  beforeDraw(chart) {
    const { ctx, chartArea } = chart;
    if (!chartArea) return;
    ctx.save();
    ctx.fillStyle = "rgba(0,0,0,0.12)";
    ctx.fillRect(chartArea.left, chartArea.top, chartArea.width, chartArea.height);
    ctx.restore();
  }
};

/* =======================
   MINI TREND LINE CHART
======================= */

function createMiniTrendChart(id, labels, rawValues, color, unit, mode) {
  const canvas = document.getElementById(id);
  if (!canvas) return;
  if (canvas._chart) canvas._chart.destroy();

  const values = toPlottable(rawValues, mode);

  // pick last visible point for highlight
  const lastPlotIdx = (() => {
    for (let i = values.length - 1; i >= 0; i--) {
      const n = Number(values[i]);
      if (Number.isFinite(n)) return i;
    }
    return -1;
  })();

  canvas._chart = new Chart(canvas.getContext("2d"), {
    type: "line",
    data: {
      labels,
      datasets: [{
        data: values,
        borderColor: color,
        backgroundColor: "rgba(255,255,255,0.08)",
        tension: 0.35,
        borderWidth: 5,
        fill: true,
        spanGaps: false,
        pointRadius: values.map((_, i) => i === lastPlotIdx ? 6 : 4),
        pointBackgroundColor: values.map((_, i) =>
          i === lastPlotIdx
            ? "rgba(255,255,255,0.98)"
            : "rgba(255,255,255,0.75)"
        )
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: t => `${Number(t.raw).toLocaleString()} ${unit}`
          },
          backgroundColor: "rgba(0,0,0,0.65)",
          borderColor: "rgba(255,255,255,0.25)",
          borderWidth: 1
        }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: {
            color: "rgba(255,255,255,0.96)",
            font: { size: 12, weight: "700" },
            autoSkip: false,          // show all 6
            maxRotation: 45,          // slant to fit
            minRotation: 45,
            padding: 6
          }
        },
        y: {
          beginAtZero: true,
          grid: { color: "rgba(255,255,255,0.15)" },
          ticks: {
            color: "rgba(255,255,255,0.96)",
            font: { size: 14, weight: "700" },
            callback: v => {
              const n = Number(v);
              if (n >= 1000000) return (n / 1000000).toFixed(1) + "M";
              if (n >= 1000) return (n / 1000).toFixed(0) + "K";
              return n;
            }
          }
        }
      }
    },
    plugins: [chartBgPlugin]
  });
}

/* =======================
   FETCH + RENDER
======================= */

document.addEventListener("DOMContentLoaded", () => {
  fetch("/api/summary")
    .then(r => r.json())
    .then(data => {
      const labels = data.labels || [];
      const energy = data.energy || [];
      const solar = data.solar || [];
      const water = data.water || [];
      const waste = data.waste || [];


      const ePick = pickLatestDisplay(labels, energy, "any");
      const sPick = pickLatestDisplay(labels, solar, "positive"); // solar: last positive month
      const wPick = pickLatestDisplay(labels, water, "any");
      const waPick = pickLatestDisplay(labels, waste, "any");

document.getElementById("miniWasteValue").textContent =
  waPick.value.toLocaleString() + " kg";


      document.getElementById("miniEnergyValue").textContent =
        ePick.value.toLocaleString() + " kWh";

      document.getElementById("miniSolarValue").textContent =
        sPick.value.toLocaleString() + " kWh";

      document.getElementById("miniWaterValue").textContent =
        wPick.value.toLocaleString() + " m³";

      document.getElementById("miniEnergyPeak").textContent =
        (energy.length ? Math.max(...energy.map(Number).filter(Number.isFinite)) : 0).toLocaleString() + " kWh";

      // solar peak ignores 0 and negatives
      document.getElementById("miniSolarPeak").textContent =
        maxPositive(solar).toLocaleString() + " kWh";

      document.getElementById("miniWaterPeak").textContent =
        (water.length ? Math.max(...water.map(Number).filter(Number.isFinite)) : 0).toLocaleString() + " m³";

      document.getElementById("miniWastePeak").textContent =
        (waste.length ? Math.max(...waste.map(Number).filter(Number.isFinite)) : 0).toLocaleString() + " kg";


      createMiniTrendChart(
        "miniEnergyChart",
        labels,
        energy,
        "rgba(255,214,10,0.95)",
        "kWh",
        "any"
      );

      createMiniTrendChart(
        "miniSolarChart",
        labels,
        solar,
        "rgba(255,85,0,0.95)",
        "kWh",
        "positive"   // solar: do not plot 0 or negative
      );

      createMiniTrendChart(
        "miniWaterChart",
        labels,
        water,
        "rgba(0,190,255,0.95)",
        "m³",
        "any"
      );

      createMiniTrendChart(
        "miniWasteChart",
        labels,
        waste,
        "rgba(50,205,50,0.95)",
        "kg",
        "any"
      );

    })
    .catch(err => console.error("Summary fetch failed:", err));
});
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {

    const carouselEl = document.getElementById("productCarousel");

    // ✅ NEW: count videos once
    const videos = document.querySelectorAll("#productCarousel video");
    const isSingleVideo = videos.length === 1;

    if (bootstrap.Carousel.getInstance(carouselEl)) {
      bootstrap.Carousel.getInstance(carouselEl).dispose();
    }

    const carousel = new bootstrap.Carousel(carouselEl, {
      interval: false,
      pause: false,
      wrap: true
    });

    function playActiveVideo() {
      const activeVideo = document.querySelector(".carousel-item.active video");
      if (activeVideo) {
        activeVideo.currentTime = 0;

        // ✅ NEW: loop when only one video
        if (isSingleVideo) {
          activeVideo.loop = true;
        }

        activeVideo.play();
      }
    }

    // ✅ CHANGED: only add "ended → next" if there are 2+ videos
    if (!isSingleVideo) {
      videos.forEach(video => {
        video.addEventListener("ended", () => {
          carousel.next();
        });
      });
    }

    carouselEl.addEventListener("slid.bs.carousel", playActiveVideo);

    playActiveVideo();
  });
</script>

<script>
(function () {
  const routes = [
    "/",
    "/electgraph",
    "/solargraph",
    "/watergraph",
    "/wastegraph"
  ];

  const delay = 30000;

  const path = window.location.pathname.replace(/\/+$/, "") || "/";
  const index = routes.indexOf(path);

  if (index === -1) return;

  setTimeout(() => {
    window.location.href = routes[(index + 1) % routes.length];
  }, delay);
})();
</script>





</body>
</html>
