<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <link rel="stylesheet" href="/stylesheets/glass.css">
  <title>ESG Centre Dashboard</title>

  <style>
    body {
      background-image: url("/images/drew-saurus-unsplash.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }

    .mini-dashboard {
      margin: 40px 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 28px;
    }

    .mini-card {
      border-radius: 22px;
      padding: 22px 24px;
      cursor: pointer;
      min-height: 240px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .mini-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 30px rgba(0,0,0,0.4);
    }

    .mini-card h5 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .mini-value {
      font-size: 2.4rem;
      font-weight: 800;
      margin-bottom: 10px;
    }

    .mini-card canvas {
      height: 190px !important;
    }

    .carousel-item {
      height: 600px;
    }

    .video-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    img#rpmapImg {
      width: 100%;
      max-width: 900px;
    }
  </style>

  <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
</head>

<body>

  <%- include('partials/navbar.ejs') %>

  <div class="container mt-4 text-center">
    <h2 class="glass glass-heading mb-4">Monthly Trend (Last 6 Months)</h2>

    <div class="mini-dashboard">

      <div class="mini-card glass" onclick="window.location.href='/electgraph'">
        <h5>Monthly Energy</h5>
        <div id="miniEnergyValue" class="mini-value">Loading...</div>
        <canvas id="miniEnergyChart"></canvas>
      </div>

      <div class="mini-card glass" onclick="window.location.href='/solargraph'">
        <h5>Monthly Solar</h5>
        <div id="miniSolarValue" class="mini-value">Loading...</div>
        <canvas id="miniSolarChart"></canvas>
      </div>

      <div class="mini-card glass" onclick="window.location.href='/watergraph'">
        <h5>Monthly Water</h5>
        <div id="miniWaterValue" class="mini-value">Loading...</div>
        <canvas id="miniWaterChart"></canvas>
      </div>

      <div class="mini-card glass">
        <h5>Peak Monthly Energy (Last 6)</h5>
        <div id="miniEnergyPeak" class="mini-value">Loading...</div>
        <p>Highest month in the last 6 months</p>
      </div>

      <div class="mini-card glass">
        <h5>Peak Monthly Solar (Last 6)</h5>
        <div id="miniSolarPeak" class="mini-value">Loading...</div>
        <p>Highest month in the last 6 months</p>
      </div>

      <div class="mini-card glass">
        <h5>Peak Monthly Water (Last 6)</h5>
        <div id="miniWaterPeak" class="mini-value">Loading...</div>
        <p>Highest month in the last 6 months</p>
      </div>

    </div>
  </div>

  <div class="carousel-container container mt-4">
    <div id="productCarousel" class="carousel slide">
      <div class="carousel-inner">
        <% videos.forEach((video, index) => { %>
          <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
            <video class="d-block w-100 video-video" playsinline>
              <source src="/videos/<%= video.video %>" type="video/mp4">
            </video>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="container mt-5 text-center">
    <h2 class="glass glass-heading mb-3">Interactive 3D Campus Map</h2>

    <model-viewer
      id="campusModel"
      src="/models/campuss.glb"
      camera-controls
      auto-rotate
      environment-image="neutral"
      interaction-prompt="none"
      touch-action="none"
      shadow-intensity="1"
      exposure="0.5"
      style="width:100%;height:600px;background:#fff;border-radius:20px;">
    </model-viewer>
  </div>

  <%- include('partials/bottomnav.ejs') %>

  <script>
  const chartBgPlugin = {
    id: "chartBg",
    beforeDraw(chart) {
      const { ctx, chartArea } = chart;
      if (!chartArea) return;
      ctx.save();
      ctx.fillStyle = "rgba(0,0,0,0.12)";
      ctx.fillRect(chartArea.left, chartArea.top, chartArea.width, chartArea.height);
      ctx.restore();
    }
  };

  function createMiniTrendChart(id, labels, values, color, unit) {
    const canvas = document.getElementById(id);
    if (!canvas) return;
    if (canvas._chart) canvas._chart.destroy();

    const ctx = canvas.getContext("2d");

    canvas._chart = new Chart(ctx, {
      type: "line",
      data: {
        labels,
        datasets: [{
          data: values,
          borderColor: color,
          backgroundColor: "rgba(255,255,255,0.08)",
          tension: 0.35,
          pointRadius: 5,
          pointHoverRadius: 6,
          pointBackgroundColor: "rgba(255,255,255,0.95)",
          borderWidth: 5,
          fill: true
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: { label: t => `${Number(t.raw).toLocaleString()} ${unit}` },
            backgroundColor: "rgba(0,0,0,0.65)",
            borderColor: "rgba(255,255,255,0.25)",
            borderWidth: 1
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              color: "rgba(255,255,255,0.96)",
              font: { size: 12, weight: "600" }
            }
          },
          y: {
            beginAtZero: true,
            grid: { color: "rgba(255,255,255,0.15)" },
            ticks: {
              color: "rgba(255,255,255,0.96)",
              font: { size: 14, weight: "700" },
              callback: v => {
                const n = Number(v);
                if (n >= 1000000) return (n / 1000000).toFixed(1) + "M";
                if (n >= 1000) return (n / 1000).toFixed(0) + "K";
                return n;
              }
            }
          }
        }
      },
      plugins: [chartBgPlugin]
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    fetch("/api/summary")
      .then(r => r.json())
      .then(data => {
        const labels = data.labels || [];
        const energy = data.energy || [];
        const solar = data.solar || [];
        const water = data.water || [];

        console.log("SUMMARY labels:", labels);

        const energyLatest = energy.length ? energy[energy.length - 1] : 0;
        const solarLatest = solar.length ? solar[solar.length - 1] : 0;
        const waterLatest = water.length ? water[water.length - 1] : 0;

        document.getElementById("miniEnergyValue").textContent =
          Number(energyLatest).toLocaleString() + " kWh";
        document.getElementById("miniSolarValue").textContent =
          Number(solarLatest).toLocaleString() + " kWh";
        document.getElementById("miniWaterValue").textContent =
          Number(waterLatest).toLocaleString() + " m³";

        document.getElementById("miniEnergyPeak").textContent =
          (energy.length ? Math.max(...energy) : 0).toLocaleString() + " kWh";
        document.getElementById("miniSolarPeak").textContent =
          (solar.length ? Math.max(...solar) : 0).toLocaleString() + " kWh";
        document.getElementById("miniWaterPeak").textContent =
          (water.length ? Math.max(...water) : 0).toLocaleString() + " m³";

        createMiniTrendChart("miniEnergyChart", labels, energy, "rgba(255,214,10,0.95)", "kWh");
        createMiniTrendChart("miniSolarChart", labels, solar, "rgba(255,85,0,0.95)", "kWh");
        createMiniTrendChart("miniWaterChart", labels, water, "rgba(0,190,255,0.95)", "m³");
      })
      .catch(err => console.error("Summary fetch failed:", err));
  });
</script>

</body>
</html>
