<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="/stylesheets/glass.css">
  <title>ESG Centre Dashboard</title>

  <style>
    body {
      background-image: url("/images/drew-saurus-unsplash.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }

    .mini-dashboard {
      margin: 40px 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 24px;
    }

    .mini-card {
      border-radius: 18px;
      padding: 18px 20px;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      min-height: 200px;
      text-align: left;
    }

    .mini-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.35);
    }

    .mini-card h5 {
      margin-bottom: 6px;
      font-size: 1.1rem;
      font-weight: 600;
    }

    .mini-value {
      font-size: 1.4rem;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .mini-card canvas {
      height: 120px !important;
    }

    .carousel-item {
      height: 600px;
    }

    .video-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    img#rpmapImg {
      width: 100%;
      max-width: 900px;
    }
  </style>

  <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>

</head>

<body>

  <%- include('partials/navbar.ejs') %>

  <div class="container mt-4 text-center">
    <h2 class="glass glass-heading text-center mb-4">Latest Month's Data</h2>

    <div class="mini-dashboard">

      <div class="mini-card glass metric-card" onclick="window.location.href='/electgraph'">
        <h5>Energy</h5>
        <div id="miniEnergyValue" class="mini-value">Loading...</div>
        <canvas id="miniEnergyChart"></canvas>
      </div>

      <div class="mini-card glass metric-card" onclick="window.location.href='/solargraph'">
        <h5>Solar</h5>
        <div id="miniSolarValue" class="mini-value">Loading...</div>
        <canvas id="miniSolarChart"></canvas>
      </div>

      <div class="mini-card glass metric-card" onclick="window.location.href='/watergraph'">
        <h5>Water</h5>
        <div id="miniWaterValue" class="mini-value">Loading...</div>
        <canvas id="miniWaterChart"></canvas>
      </div>

      <div class="mini-card glass metric-card">
        <h5>Peak Monthly Energy</h5>
        <div id="miniEnergyPeak" class="mini-value">Loading...</div>
        <p class="mb-0">Highest value in the selected period</p>
      </div>

      <div class="mini-card glass metric-card">
        <h5>Peak Monthly Solar</h5>
        <div id="miniSolarPeak" class="mini-value">Loading...</div>
        <p class="mb-0">Highest value in the selected period</p>
      </div>

      <div class="mini-card glass metric-card">
        <h5>Peak Monthly Water</h5>
        <div id="miniWaterPeak" class="mini-value">Loading...</div>
        <p class="mb-0">Highest value in the selected period</p>
      </div>

    </div>
  </div>

  <div class="carousel-container container mt-4">
    <div id="productCarousel" class="carousel slide">

      <div class="carousel-inner">
        <% videos.forEach((video, index) => { %>
          <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
            <video class="d-block w-100 video-video" playsinline>
              <source src="/videos/<%= video.video %>" type="video/mp4">
              <source src="/videos/<%= video.video %>.webm" type="video/webm">
              <source src="/videos/<%= video.video %>.ogg" type="video/ogg">
            </video>
          </div>
        <% }) %>
      </div>

    </div>
  </div>

  <div class="container mt-5 text-center">
    <h2 class="glass glass-heading mb-3">Interactive 3D Campus Map</h2>

    <model-viewer 
      id="campusModel"
      src="/models/campuss.glb"
      camera-controls
      auto-rotate
      environment-image="neutral"
      interaction-prompt="none"
      touch-action="none"
      shadow-intensity="1"
      exposure="0.5"
      style="width: 100%; height: 600px; background: #ffffff; border-radius: 20px;">
    </model-viewer>
    <script>
      document.getElementById("campusModel")
        .addEventListener("click", (event) => {
          const hit = event.detail;
          if (hit && hit.mesh) {
            console.log("Clicked:", hit.mesh.name);

            switch (hit.mesh.name) {
              case "E1": window.location.href = "/building/E1"; break;
              case "E2": window.location.href = "/building/E2"; break;
              case "W1": window.location.href = "/building/W1"; break;
              // add more here
            }
          }
        });
    </script>

  </div>

  <div class="container text-center mt-5" style="margin-bottom: 120px;">

    <img id="rpmapImg" src="/images/rpmap.png" usemap="#rpmap">

    <map name="rpmap">

      <area alt="E1" shape="rect" coords="452,585,512,652" onclick="openMenu('E1')">
      <area alt="E2" shape="rect" coords="594,612,530,541" onclick="openMenu('E2')">
      <area alt="E3" shape="rect" coords="451,488,512,559" onclick="openMenu('E3')">
      <area alt="E4" shape="rect" coords="530,451,593,519" onclick="openMenu('E4')">
      <area alt="E5" shape="rect" coords="531,342,596,412" onclick="openMenu('E5')">
      <area alt="E6" shape="rect" coords="448,299,514,370" onclick="openMenu('E6')">

      <area alt="W1" shape="rect" coords="373,642,434,710" onclick="openMenu('W1')">
      <area alt="W2" shape="rect" coords="291,574,350,640" onclick="openMenu('W2')">
      <area alt="W3" shape="rect" coords="291,489,350,557" onclick="openMenu('W3')">
      <area alt="W4" shape="rect" coords="374,465,434,535" onclick="openMenu('W4')">
      <area alt="W5" shape="rect" coords="291,393,351,459" onclick="openMenu('W5')">
      <area alt="W6" shape="rect" coords="371,343,431,411" onclick="openMenu('W6')">

    </map>
  </div>

  <%- include('partials/bottomnav.ejs') %>

  <script>
    function openMenu(buildingId) {
      alert("You clicked " + buildingId);
      console.log("Clicked:", buildingId);
    }

    function createMiniChart(id, data, color) {
      const ctx = document.getElementById(id);
      if (!ctx) return;

      new Chart(ctx, {
        type: 'line',
        data: {
          labels: data.map((_, i) => i + 1),
          datasets: [{
            data: data,
            borderColor: color,
            backgroundColor: 'transparent',
            tension: 0.3,
            pointRadius: 0
          }]
        },
        options: {
          plugins: { legend: { display: false }},
          scales: { x: { display: false }, y: { display: false } }
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      fetch(window.location.origin + "/api/summary")
        .then(res => res.json())
        .then(data => {
          const energy = data.energy;
          const solar = data.solar;
          const water = data.water;

          const energyLatest = energy[energy.length - 1];
          const solarLatest = solar[solar.length - 1];
          const waterLatest = water[water.length - 1];

          document.getElementById("miniEnergyValue").textContent =
            energyLatest.toLocaleString() + " kWh";

          document.getElementById("miniSolarValue").textContent =
            solarLatest.toLocaleString() + " kWp";

          document.getElementById("miniWaterValue").textContent =
            waterLatest.toLocaleString() + " m³";

          createMiniChart("miniEnergyChart", energy, "#ffc107");
          createMiniChart("miniSolarChart", solar, "orangered");
          createMiniChart("miniWaterChart", water, "#007bff");

          const energyPeakEl = document.getElementById("miniEnergyPeak");
          const solarPeakEl = document.getElementById("miniSolarPeak");
          const waterPeakEl = document.getElementById("miniWaterPeak");

          if (energyPeakEl) {
            const energyMax = Math.max(...energy);
            energyPeakEl.textContent = energyMax.toLocaleString() + " kWh";
          }

          if (solarPeakEl) {
            const solarMax = Math.max(...solar);
            solarPeakEl.textContent = solarMax.toLocaleString() + " kWp";
          }

          if (waterPeakEl) {
            const waterMax = Math.max(...water);
            waterPeakEl.textContent = waterMax.toLocaleString() + " m³";
          }
        });
    });
  </script>

  <script>
    document.addEventListener("DOMContentLoaded", function () {

      const carouselEl = document.getElementById("productCarousel");

      if (bootstrap.Carousel.getInstance(carouselEl)) {
        bootstrap.Carousel.getInstance(carouselEl).dispose();
      }

      const carousel = new bootstrap.Carousel(carouselEl, {
        interval: false,
        pause: false,
        wrap: true
      });

      function playActiveVideo() {
        const activeVideo = document.querySelector(".carousel-item.active video");
        if (activeVideo) {
          activeVideo.currentTime = 0;
          activeVideo.play();
        }
      }

      document.querySelectorAll("#productCarousel video").forEach(video => {
        video.addEventListener("ended", () => {
          carousel.next();
        });
      });

      carouselEl.addEventListener("slid.bs.carousel", playActiveVideo);

      playActiveVideo();
    });
  </script>

</body>
</html>
