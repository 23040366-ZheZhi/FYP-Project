<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>ESG Centre Dashboard</title>
</head>
<body>

  <%- include ('partials/navbar.ejs') %>

  <img src="/images/rplogo.jpg" class="mx-auto d-block" style="width: 400px; height: 300px;">  

  <div class="carousel-container">
    <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <% games.forEach((game, index) => { %>
                <button type="button" data-bs-target="#productCarousel" data-bs-slide-to="<%= index %>" class="<%= index === 0 ? 'active' : '' %>" aria-current="<%= index === 0 ? 'true' : 'false' %>" aria-label="Slide <%= index + 1 %>"></button>
            <% }) %>
        </div>
        <div class="carousel-inner">
            <% games.forEach((game, index) => { %>
                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                  <video class="d-block w-100 game-image" autoplay muted loop playsinline>
                    <source src="/videos/<%= game.image %>" type="video/mp4">
                  </video>
                    <div class="carousel-caption d-none d-md-block">
                        <h5><%=  %></h5>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</div>

<style>
    .carousel-item {
        height: 550px; 
    }
    .game-image {
        width: 100%;
        height: 100%;
        object-fit: fit; 
    }
    .carousel-caption h5 {
        color: gold; 
        font-weight: bold;
        background-color: black;
    }
</style>


  <div class="container text-center mt-4">
    <h2>Select a Building</h2>
    <img src="/images/rpmap.png" usemap="#rpmap">

    <map name="rpmap">

      <area alt="E1" title="E1"
        shape="rect"
        coords="452,585,512,652"
        data-original-coords="452,585,512,652"
        onclick="openMenu('E1')">

      <area alt="E2" title="E2"
            shape="rect"
            coords="594,612,530,541"
            data-original-coords="594,612,530,541"
            onclick="openMenu('E2')">

      <area alt="E3" title="E3"
            shape="rect"
            coords="451,488,512,559"
            data-original-coords="451,488,512,559"
            onclick="openMenu('E3')">

      <area alt="E4" title="E4"
            shape="rect"
            coords="530,451,593,519"
            data-original-coords="530,451,593,519"
            onclick="openMenu('E4')">

      <area alt="E5" title="E5"
            shape="rect"
            coords="531,342,596,412"
            data-original-coords="531,342,596,412"
            onclick="openMenu('E5')">

      <area alt="E6" title="E6"
            shape="rect"
            coords="448,299,514,370"
            data-original-coords="448,299,514,370"
            onclick="openMenu('E6')">

      <area alt="W1" title="W1"
            shape="rect"
            coords="373,642,434,710"
            data-original-coords="373,642,434,710"
            onclick="openMenu('W1')">

      <area alt="W2" title="W2"
            shape="rect"
            coords="291,574,350,640"
            data-original-coords="291,574,350,640"
            onclick="openMenu('W2')">

      <area alt="W3" title="W3"
            shape="rect"
            coords="291,489,350,557"
            data-original-coords="291,489,350,557"
            onclick="openMenu('W3')">

      <area alt="W4" title="W4"
            shape="rect"
            coords="374,465,434,535"
            data-original-coords="374,465,434,535"
            onclick="openMenu('W4')">

      <area alt="W5" title="W5"
            shape="rect"
            coords="291,393,351,459"
            data-original-coords="291,393,351,459"
            onclick="openMenu('W5')">

      <area alt="W6" title="W6"
            shape="rect"
            coords="371,343,431,411"
            data-original-coords="371,343,431,411"
            onclick="openMenu('W6')">

    </map>
</div>

  
  <script>
    function openMenu(buildingId) {
    console.log("Clicked:", buildingId);
    alert("You clicked " + buildingId);
     }

    document.addEventListener('DOMContentLoaded', () => {
      const descriptions = document.querySelectorAll('.description');
      descriptions.forEach(description => {
        const maxLength = 100;
        if (description.textContent.length > maxLength) {
          const truncated = description.textContent.substring(0, maxLength) + '...';
          description.textContent = truncated;
        }
      });
    });

    function resizeImageMap() {
    const img = document.getElementById("rpmapImg");
    const map = document.querySelector("map[name='image-map']");
    if (!img || !map) return;

    const originalWidth = 800;  // replace with real width of rpmap.png
    const originalHeight = 600; // replace with real height of rpmap.png

    const ratioX = img.clientWidth / originalWidth;
    const ratioY = img.clientHeight / originalHeight;

    map.querySelectorAll("area").forEach(area => {
      const original = area.dataset.originalCoords;
      if (!original) return;

      const nums = original.split(",").map(Number);
      const scaled = nums.map((value, index) => {
        if (index % 2 === 0) {
          return Math.round(value * ratioX);
        } else {
          return Math.round(value * ratioY);
        }
      });
      area.coords = scaled.join(",");
    });
  }

  window.addEventListener("load", resizeImageMap);
  window.addEventListener("resize", resizeImageMap);
  </script>
</body>
</html>
