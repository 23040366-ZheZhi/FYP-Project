<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Media Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

    <style>
        .list-group-item { cursor: grab; }
        .list-group-item:active { cursor: grabbing; }
    </style>
    <link rel="stylesheet" href="/stylesheets/glass.css">
</head>
<style>
    body {
      background-image: url("/images/287510.gif");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<body>

<%- include("partials/navbar.ejs") %>

<div class="container mt-4">
    <h2 class="text-center mb-4" style="color: white;">Video Sequence</h2>

    <form action="/media_management" method="POST" style="margin-bottom: 100px;">

        <ul id="videoList" class="list-group mb-3">
            <% videos.forEach(video => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center" data-id="<%= video.id %>">
                    <div>
                        <strong>Name: <%= video.name %></strong><br>
                        <small>Description: <%= video.description %></small>
                    </div>
                    <button type="submit" class="btn btn-danger btn-sm" formaction="/deleteVideo/<%= video.id %>" formmethod="POST" onclick="return confirm('Are you sure you want to delete this video?')">
                        Delete
                    </button>
                </li>
            <% }); %>
        </ul>

        <input type="hidden" id="orderInput" name="order">

        <button type="submit" class="btn btn-primary">Save Order</button>
    </form>
    <h2 class="text-center mb-4" style="color: white;">Add Videos to Sequence</h2>

    <form action="/addVideo" method="POST" enctype="multipart/form-data">
        <div id="video-container">
            <!-- FIRST VIDEO BLOCK -->
            <div class="video-block mb-3">
                <div class="row mt-3">
                    <div class="col-md-3">
                        <label class="d-block">Video:</label>
                        <input type="file"
                        class="form-control"
                        name="videos[]"
                        accept="video/*,image/*"
                        onchange="previewVideo(this)"
                        required>
                    <label class="preview-label fw-bold mt-2" style="font-weight: bold; margin-top: 10px; color: white;">Preview: </label>
                    <video class="preview-video w-100 d-none d-block" style="height:250px; object-fit:cover; margin-top:0; display:block;" preload="metadata" controls ></video>
                    <img class="preview-image w-100 d-none"style="height:250px; object-fit:cover; margin-top:0;">
                </div>

            </div>
                <label class="mt-3">Description:</label>
                <input type="text" class="form-control" name="descriptions[]" placeholder="Enter description">
            </div>
        </div>
            <!-- SUBMIT + BACK -->
            <button class="btn btn-primary mt-3" type="submit">Add Video</button>
            <!-- ADD BUTTON -->
            <button type="button" class="btn btn-success mt-3" onclick="addMore()">+ Add More Videos</button>
    </form>
</div>

<script>
    // Drag & drop reorder
    new Sortable(videoList, {
        animation: 150,
        onEnd: () => {
            const newOrder = [...document.querySelectorAll("#videoList li")]
                .map(li => li.dataset.id);
            document.getElementById("orderInput").value = newOrder.join(",");
        }
    });

    // Add more upload blocks
    function addMore() {
        const container = document.getElementById("video-container");
        const block = document.createElement("div");
        block.classList.add("video-block", "mb-3");
        block.innerHTML = `
            <div class="row mt-3">
                <div class="col-md-3">
                    <label class="d-block">Video:</label>
                    <input type="file"
                        class="form-control"
                        name="videos[]"
                        accept="video/*,image/*"
                        onchange="previewVideo(this)"
                        required>

                    <label class="preview-label fw-bold mt-2 d-none" style="font-weight: bold; margin-top: 10px;">Preview:</label>
                    <video class="preview-video w-100 d-none"
                        style="height:250px; object-fit:cover; margin-top:0;"
                        preload="metadata"controls>
                    </video>
                    <img class="preview-image w-100 d-none" style="height:250px; object-fit:cover; margin-top:0;">
                </div>
            </div>

            <label class="form-label mt-2">Description:</label>
            <input type="text" class="form-control" name="descriptions[]" placeholder="Enter description">
            <br>
            <button type="button" class="btn btn-danger" onclick="removeBlock(this)">
                Delete Block
            </button>
        `;
        container.appendChild(block);
    }

    // Delete function for each additional block
    function removeBlock(btn) {
        const container = document.getElementById("video-container");
        const blocks = container.getElementsByClassName("video-block");

        // prevent deleting the last remaining block
        if (blocks.length <= 1) return;
        btn.closest(".video-block").remove();
    }

    // shows preview of video before adding
    function previewVideo(input) {
        const file = input.files[0];
        if (!file) return;

        const preview = input.nextElementSibling;
        const video = preview.nextElementSibling;
        const image = video.nextElementSibling;
        const url = URL.createObjectURL(file);
        
        preview.classList.remove("d-none");
        video.classList.add("d-none");
        image.classList.add("d-none");

        video.pause();
        video.removeAttribute("src");
        video.load();

        if (file.type.startsWith("video/")) {
            const canPlay = video.canPlayType(file.type);
            if (canPLay === ""){
                alert("Video format not supported!");
                input.value = "";
                return;
            }

            video.classList.remove("d-none");
            video.src = url;
            video.load();
        }

        else if (file.type.startsWith("image/")) {
            image.classList.remove("d-none");
            image.src= url;
        }

        else {
            alert("File type not supported! Please select a video or image file.");
            input.value = "";
            return;
        }
    }
</script>

</body>
</html>
