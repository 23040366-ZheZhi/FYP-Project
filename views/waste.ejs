<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Waste Data</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Lalezar font -->
  <link href="https://fonts.googleapis.com/css2?family=Lalezar&display=swap" rel="stylesheet">

  <style>
    /* ===== FULL SCREEN FIGMA BACKGROUND ===== */
    html, body { height: 100%; margin: 0; }
    body{
      font-family: Arial, sans-serif;
      overflow-x: hidden;
      overflow-y: auto;
      background: url("/images/waste-bg.png") center / cover no-repeat fixed;
    }

    .stage{
      min-height: 100vh;
      position: relative;
    }

    /* Optional overlay to help chart readability */
    .stage::after{
      content:"";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background: rgba(0,0,0,0.10);
      z-index: 1;
    }

    /* ===== RECYCLE LOGO (smaller + moved down) ===== */
    .recycle-logo{
      position: fixed;
      top: 50px;          /* ⬅ move down (adjust if needed) */
      left: 50%;
      transform: translateX(-50%);
      width: 120px;        /* ⬅ smaller */
      height: auto;
      z-index: 2;
      pointer-events: none;
      filter: drop-shadow(0 10px 18px rgba(0,0,0,.20));
    }

    /* ===== FLOATING PAPER BALLS ===== */
    .waste-scene{
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 2;
    }
    .paper{
      position: absolute;
      width: 140px;
      opacity: 0;
      will-change: transform, opacity;
      filter: drop-shadow(0 14px 22px rgba(0,0,0,.18));
    }

    @keyframes dropIn {
      0%   { transform: translateY(-180px) scale(.95); opacity: 0; }
      60%  { transform: translateY(12px)  scale(1.02); opacity: 1; }
      100% { transform: translateY(0)     scale(1); opacity: 1; }
    }
    @keyframes hoverFloat {
      0%   { transform: translateY(0); }
      50%  { transform: translateY(-10px); }
      100% { transform: translateY(0); }
    }

    /* FINAL positions */
    .p1 { top: 70px;  left: 5%;  width: 90px; }
    .p2 { top: 120px; left: 18%; width: 110px; }
    .p3 { top: 40px;  left: 55%; width: 170px; }
    .p4 { top: 180px; right: 8%; width: 120px; }
    .p5 { bottom: 35px; left: 6%; width: 210px; }
    .p6 { bottom: 35px; right: 3%; width: 260px; }

    .p1{ animation: dropIn 1.1s cubic-bezier(.2,.8,.25,1) forwards, hoverFloat 4.2s ease-in-out infinite; animation-delay: 0s, 1.1s; }
    .p2{ animation: dropIn 1.1s cubic-bezier(.2,.8,.25,1) forwards, hoverFloat 5.0s ease-in-out infinite; animation-delay: .12s, 1.22s; }
    .p3{ animation: dropIn 1.1s cubic-bezier(.2,.8,.25,1) forwards, hoverFloat 4.6s ease-in-out infinite; animation-delay: .24s, 1.34s; }
    .p4{ animation: dropIn 1.1s cubic-bezier(.2,.8,.25,1) forwards, hoverFloat 5.4s ease-in-out infinite; animation-delay: .36s, 1.46s; }
    .p5{ animation: dropIn 1.1s cubic-bezier(.2,.8,.25,1) forwards, hoverFloat 6.0s ease-in-out infinite; animation-delay: .48s, 1.58s; }
    .p6{ animation: dropIn 1.1s cubic-bezier(.2,.8,.25,1) forwards, hoverFloat 6.6s ease-in-out infinite; animation-delay: .60s, 1.70s; }

    /* ===== UI (AUTO SHOW, NOT CLICKABLE) ===== */
    .ui{
      position: relative;
      z-index: 3;
      max-width: 1100px;
      margin: 0 auto;
      padding: 170px 12px 120px; /* ⬅ space for logo */
      opacity: 1;               /* always visible */
      transform: none;
      pointer-events: auto;
    }

    /* ===== Card now matches Water page layout (NO animation touched) ===== */
    .chart-wrap{
      max-width: 1000px;
      margin: 0 auto;
      background: rgba(255,255,255,.88);
      padding: 18px;
      border-radius: 18px;
      box-shadow: 0 20px 60px rgba(0,0,0,.22);
      backdrop-filter: blur(10px);
      position: relative;
      overflow: hidden;
    }

    .chart-wrap::before{
      content:"";
      position:absolute;
      inset:-40px;
      background: radial-gradient(circle at 30% 20%, rgba(255,255,255,.22), transparent 55%);
      pointer-events:none;
    }

    .sr-only{
      position:absolute;
      width:1px; height:1px;
      padding:0; margin:-1px;
      overflow:hidden;
      clip:rect(0,0,0,0);
      border:0;
    }

    /* header + divider like your water page */
    .chart-header{
      position: relative;
      z-index: 2;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding: 6px 4px 10px;
    }

    .chart-title-main{
      font-weight: 800;
      font-size: 18px;
      color: #0b1220;
      letter-spacing: .2px;
    }

    .chart-title-sub{
      margin-top: 2px;
      font-size: 12px;
      color: rgba(17,24,39,.65);
    }

    .chart-divider{
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(0,0,0,.12), transparent);
      margin: 2px 0 12px;
      position: relative;
      z-index: 2;
    }

    /* body pushes footer down (same trick as water page) */
    .chart-body{
      display:flex;
      flex-direction:column;
      min-height:520px;
      position: relative;
      z-index: 2;
    }

    .chart-area{
      flex: 1;
      min-height: 420px;
    }

    canvas{
      width:100% !important;
      height:450px !important;
      display:block;
    }

    /* footer dropdown like water page */
    .chart-footer{
      margin-top:auto;
      padding-top:12px;
      border-top:1px solid rgba(0,0,0,.10);
      display:flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      position: relative;
      z-index: 2;
    }

    #datasetSelector{
      min-width:240px;
      padding: 10px 14px;
      font-size: 14px;
      border-radius: 999px;
      border: 1px solid rgba(0,0,0,.10);
      background: rgba(255,255,255,.72);
      color: #111827; /* selected text */
      backdrop-filter: blur(10px);
      outline: none;
      box-shadow: 0 8px 18px rgba(0,0,0,.10);
    }

    /* keep options readable */
    #datasetSelector option{
      background: #ffffff;
      color: #111827;
    }

    /* Back button (KEEP SAME) */
    .graph-back-nav{
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 4;
    }
    .graph-back-btn{
      width: 120px;
      height: 60px;
      background: rgba(0,0,0,.55);
      color: white;
      border-radius: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-size: 14px;
      box-shadow: 0 14px 30px rgba(0,0,0,.25);
      backdrop-filter: blur(10px);
    }

    /* Optional: your totals + msg (KEEP SAME) */
    .totals{
      text-align:center;
      margin-top:14px;
      font-weight:bold;
      font-size:15px;
      color:#111827;
      text-shadow: 0 10px 30px rgba(0,0,0,.35);
    }
    .msg{
      max-width: 1000px;
      margin: 10px auto 0;
      text-align: center;
      color: #ffdddd;
      font-weight: bold;
      display: none;
      text-shadow: 0 10px 30px rgba(0,0,0,.35);
    }
  </style>
</head>

<body>
  <div class="stage" id="stage">

    <!-- ✅ recycle logo -->
    <img src="/images/recycle.png" class="recycle-logo" alt="Recycle">

    <!-- paper balls (KEEP SAME animation) -->
    <div class="waste-scene">
      <img src="/images/paperball.png" class="paper p1" alt="">
      <img src="/images/paperball.png" class="paper p2" alt="">
      <img src="/images/paperball.png" class="paper p3" alt="">
      <img src="/images/paperball.png" class="paper p4" alt="">
      <img src="/images/paperball.png" class="paper p5" alt="">
      <img src="/images/paperball.png" class="paper p6" alt="">
    </div>

    <!-- UI -->
    <div class="ui">

      <!-- ✅ chart card now matches water layout: header + divider + chart + footer dropdown -->
      <div class="chart-wrap">
        <div class="chart-body">

          <div class="chart-header">
            <div class="chart-title">
              <div class="chart-title-main">Waste Data</div>
              <div class="chart-title-sub">Monthly (kg / %)</div>
            </div>
          </div>

          <div class="chart-divider"></div>
            <div class="totals" id="totalsDisplay"></div>

          <div class="chart-area">
            <canvas id="wasteChart"></canvas>
          </div>

          <!-- dropdown moved to bottom (same as water) -->
          <div class="chart-footer">
            <label class="sr-only" for="datasetSelector">Choose data</label>
            <select id="datasetSelector">
              <option value="field2">General Waste (kg)</option>
              <option value="field3">Recycled Waste (kg)</option>
              <option value="field4">% (General Waste)</option>
              <option value="field5">% (Recycled Waste)</option>
            </select>
          </div>

        </div>
      </div>

    
      <div class="msg" id="msgBox"></div>
    </div>

    <div class="graph-back-nav">
      <a href="/" class="graph-back-btn">Back</a>
    </div>
  </div>

  <!-- ✅ DO NOT TOUCH YOUR GRAPH SCRIPT -->
  <script type="module" src="/scripts/plotwaste.js"></script>

  <script>
      window.__ROTATE_CFG__ = <%- JSON.stringify(rotateCfg) %>;
      console.log(window.__ROTATE_CFG__);
  </script>
  <script src="/scripts/idle-rotate.js"></script>

</body>
</html>
