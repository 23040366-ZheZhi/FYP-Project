<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head> 
<body>
  <%- include('partials/navbar.ejs') %>


    <div class="carousel-container container mt-4">

    <% if (videos && videos.length > 0) { %>

    <div id="productCarousel" class="carousel slide">
      <div class="carousel-inner">
        <% videos.forEach((video, index) => {
          const file = video.video || "";
          const ext = file.split('.').pop().toLowerCase();
          const isImage = ['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext);
        %>
        <div class="carousel-item <%= index === 0 ? 'active' : '' %>">

            <% if (isImage) { %>
              <img class="d-block w-100" src="/videos/<%= video.video %>"alt="media">
            <% } else { %>
              <video class="d-block w-100 video-video"  playsinline muted controls>
                <source src="/videos/<%= video.video %>" type="video/mp4">
              </video>
            <% } %>

          </div>

        <% }) %>
      </div>
    </div>
  <% } else { %>
    <!-- Fallback message -->
    <div class="alert alert-warning text-center">
      No videos are available at the moment.
    </div>

  <% } %>
  </div>

  <script>
document.addEventListener("DOMContentLoaded", function () {

  const carouselEl = document.getElementById("productCarousel");
  if (!carouselEl) return;

  const carousel = new bootstrap.Carousel(carouselEl, {
    interval: false
  });

  let imgTimer = null;

  function handleSlide() {
    // clear previous image timer
    if (imgTimer) {
      clearTimeout(imgTimer);
      imgTimer = null;
    }

    const activeItem = carouselEl.querySelector(".carousel-item.active");
    if (!activeItem) return;

    const video = activeItem.querySelector("video");
    const img = activeItem.querySelector("img");

    // If it's a video → wait until finished
    if (video) {
      video.currentTime = 0;
      video.play();

      video.onended = () => {
        carousel.next();
      };
    }

    // If it's an image → move after 3 seconds
    else if (img) {
      imgTimer = setTimeout(() => {
        carousel.next();
      }, 3000);   // change 3000 = 3s if you want longer
    }
  }

  // When slide changes → handle next media
  carouselEl.addEventListener("slid.bs.carousel", handleSlide);

  // Start first slide
  handleSlide();
});
</script>
</body>
</html>