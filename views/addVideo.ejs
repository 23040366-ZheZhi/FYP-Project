<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <title>Republic Polytechnic</title>
    </head>
<body>
    
    <%- include ('partials/navbar.ejs') %>

    <div class="container">
        <br>
        <div class="text-center"><h2>Videos</h2></div>
        <br>
        <form action="/addVideo" method="POST" enctype="multipart/form-data">
            <div id="video-container">

                <!-- FIRST VIDEO BLOCK -->
                <div class="video-block mb-3">

                    <label>Video:</label>
                    <input type="file" class="form-control" name="videos[]" accept="video/*" required>

                    <label class="mt-2">Description:</label>
                    <input type="text" class="form-control" name="descriptions[]" placeholder="Enter description">

                </div>
            </div>
            <!-- ADD BUTTON -->
            <button type="button" class="btn btn-success mt-3" onclick="addMore()">+ Add More Videos</button>
            <a href="/sequence" class="btn btn-success mt-3">Manage Video Sequence</a>
            <br><br>
            <!-- SUBMIT + BACK -->
            <button class="btn btn-primary" type="submit">Add Video</button>
            <a href="/" class="btn btn-secondary">Back</a>
        </form>
    </div>
    <script>
        function addMore() {
            const container = document.getElementById("video-container");
            const block = document.createElement("div");
            block.classList.add("video-block", "mb-3");
            block.innerHTML = `
            <label>Video:</label>
            <input type="file" class="form-control" name="videos[]" accept="video/*" required>

            <label class="mt-2">Description:</label>
            <input type="text" class="form-control" name="descriptions[]" placeholder="Enter description" required>`;
            container.appendChild(block);
            }
</script>
</body>
</html>
