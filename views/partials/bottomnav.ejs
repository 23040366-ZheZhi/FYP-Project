<% if (!disableInteractive) { %>
<style>
.bottom-nav {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  padding: 10px 20px;
  width: 75%;
  display: flex;
  justify-content: space-around;
  gap: 15px;
  z-index: 1000;

  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 1px solid rgba(255, 255, 255, 0.35);
  border-radius: 60px;
  box-shadow: 0 12px 30px rgba(0,0,0,0.35);
}

.nav-circle {
  width: 60px;
  height: 60px;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 12px;
  text-decoration: none;
  padding: 6px;
  transition: 0.2s ease;
}

.nav-circle:hover {
  transform: scale(1.08);
}

.bottom-nav {
  pointer-events: none;
}

.bottom-nav .nav-circle {
  pointer-events: auto;
}


/* button colours */
.btn-home { background: #59ea40; color: black; }
.btn-water { background: #59ea40; color: black; }
.btn-solar { background: #59ea40; color: black; }
.btn-energy { background: #59ea40; color: black; }
.btn-waste { background: #59ea40; color: black; }
.btn-IndivWater { background: #59ea40; color: black; }
.btn-IndivEnergy { background: #59ea40; color: black; }
</style>


<div class="bottom-nav">
    
    <a href="/" class="nav-circle btn-home">Home</a>
    <a href="/electgraph" class="nav-circle btn-energy">Energy<br>Graph</a>
    <a href="/solargraph" class="nav-circle btn-solar">Solar<br>Graph</a>
    <a href="/watergraph" class="nav-circle btn-water">Water<br>Graph</a>
    <a href="/waste" class="nav-circle btn-waste">Waste<br>Graph</a>
    <a href="/indivwater" class="nav-circle btn-IndivWater">IndWater<br>Graph</a>
    <a href="/indivelect" class="nav-circle btn-IndivEnergy">IndEnergy<br>Graph</a>

</div>

<% } %>


