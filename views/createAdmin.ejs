<!DOCTYPE html>
<html>
<head>
    <title>Create Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include("partials/navbar") %>
<div class="container mt-5" style="max-width:400px;">
    <h3 class="text-center">Create Admin</h3>

    <form action="/create-admin" method="POST">
        <label>Username</label>
        <input class="form-control" name="username" required>

        <label class="mt-2">Password</label>
        <input class="form-control" name="password" required>

        <label class="mt-2">Email</label>
        <input type="email" class="form-control" name="email" required>

        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" name="twofa" checked>
            <label class="form-check-label">Enable 2FA</label>
        </div>

        <button class="btn btn-primary w-100 mt-3">Create</button>
    </form>

    <a href="/" class="btn btn-secondary w-100 mt-2">Back</a>
</div>
</body>
</html>