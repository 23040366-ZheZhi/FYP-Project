<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Create Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/glass.css">

  <style>
    html, body {
      height: 100%;
      margin: 0;
    }

    body {
      background-image: url("/images/background.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
     
    }

    label {
      font-size: 1.5rem;
      font-weight: 600;
    }

    
  </style>
</head>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<body>
    <%- include("partials/navbar") %>
<div class="container mt-5" style="max-width:400px;">
    <h3 class="text-center" style="color: white;">Create Admin</h3>

    <form action="/create-admin" method="POST">
        <label style="color: white;">Username</label>
        <input class="form-control form-control-lg"  name="username" required>

        <label class="mt-2" style="color: white;">Password</label>
        <input class="form-control" name="password" required>

        <label class="mt-2" style="color: white;">Email</label>
        <input type="email" class="form-control" name="email" required>

        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" name="twofa" checked>
            <label class="form-check-label" style="color: white;">Enable 2FA</label>
        </div>

        <button class="btn btn-primary w-100 mt-3">Create</button>
    </form>

    <a href="/" class="btn btn-secondary w-100 mt-2">Back</a>
</div>
</body>
</html>