<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Electricity Consumption (Individual Buildings)</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --sky: #87ceeb;
      --grass: #22c55e;
      --turbine-body: #f8fafc;
      --electric-gold: #fbbf24;
    }

    body, html {
      margin: 0; padding: 0;
      height: 100vh; width: 100vw;
      overflow-x: hidden;
      font-family: Arial, sans-serif;
      background: linear-gradient(to bottom, #29abe2, var(--sky));
    }

    /* ===== BACKGROUND ELEMENTS ===== */
    .sun {
      position: absolute; top: 30px; left: 50px;
      width: 80px; height: 80px;
      background: #fff176; border-radius: 50%;
      box-shadow: 0 0 50px #fff176; z-index: 1;
    }

    .horizon {
      position: fixed; bottom: 0; width: 100%; height: 40px;
      background: var(--grass); z-index: 5;
      border-top: 5px solid #16a34a;
    }

    /* ===== THE TURBINE FARM (Added 4 to ensure none are "missing") ===== */
    .turbine-farm {
      position: fixed; bottom: 40px; width: 100%;
      display: flex; justify-content: space-around; 
      align-items: flex-end; z-index: 2;
      pointer-events: none;
    }

    .turbine { display: flex; flex-direction: column; align-items: center; position: relative; }
    .tower {
      width: 8px; height: 160px;
      background: linear-gradient(90deg, #e2e8f0, #cbd5e1);
      clip-path: polygon(30% 0%, 70% 0%, 100% 100%, 0% 100%);
    }
    .blades {
      position: absolute; top: -60px; width: 120px; height: 120px;
      animation: spin var(--speed) linear infinite;
    }
    .blade {
      position: absolute; top: 50%; left: 50%;
      width: 8px; height: 60px; background: var(--turbine-body);
      transform-origin: top center; border-radius: 0 0 10px 10px;
    }

    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    /* ===== GENERATOR HUB ===== */
    .generator {
      position: fixed; bottom: 15px; left: 50%; transform: translateX(-50%);
      width: 90px; height: 55px; background: #334155;
      border-radius: 8px; z-index: 10; border: 3px solid #1e293b;
      transition: all 0.8s ease; display: flex; align-items: center; justify-content: center;
    }
    .charged { background: var(--electric-gold); box-shadow: 0 0 30px var(--electric-gold); border-color: #d97706; }
    .bolt { font-size: 22px; color: white; opacity: 0; }
    .charged .bolt { opacity: 1; animation: flicker 0.5s infinite; }
    @keyframes flicker { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

    /* ===== MAIN WRAPPER ===== */
    .main-reveal {
      position: relative; z-index: 20;
      opacity: 0; transform: translateY(40px);
      transition: all 1s ease-out;
    }
    body.ready .main-reveal { opacity: 1; transform: translateY(0); }

    h2 { text-align: center; margin: 20px 0; color: white; text-shadow: 0 2px 10px rgba(0,0,0,0.2); }

    .wrap {
      max-width: 1400px; width: 92%; margin: 0 auto;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 14px; padding: 14px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.1);
      display: flex; flex-direction: column;
    }

    .chart-area { position: relative; height: 520px; width: 100%; }
    canvas { width: 100% !important; height: 100% !important; display: block; }

    .graph-back-nav { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); z-index: 2000; }
    .graph-back-btn {
      width: 130px; height: 56px; background: #343a40; color: white;
      border-radius: 50px; display: flex; align-items: center; justify-content: center;
      font-weight: 700; text-decoration: none; box-shadow: 0 8px 20px rgba(0,0,0,0.18);
    }

    /* Responsive Heights */
    @media (max-width: 600px) { .chart-area { height: 320px; } }
  </style>
</head>

<body>
  <div class="sun"></div>
  
  <div class="turbine-farm">
    <div class="turbine" style="--speed: 3.5s;"><div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div><div class="tower"></div></div>
    <div class="turbine" style="--speed: 2.5s; transform: scale(1.1);"><div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div><div class="tower"></div></div>
    <div class="turbine" style="--speed: 4.5s; transform: scale(0.9);"><div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div><div class="tower"></div></div>
    <div class="turbine" style="--speed: 3s; transform: scale(1.2);"><div class="blades"><div class="blade"></div><div class="blade"></div><div class="blade"></div></div><div class="tower"></div></div>
  </div>

  <div class="horizon"></div>

  <div class="generator" id="gen">
    <span class="bolt">⚡</span>
  </div>

  <div class="main-reveal">
    <h2>Electricity Consumption (Individual Buildings)</h2>
    <div class="wrap">
      <div class="chart-area">
        <canvas id="chart"></canvas>
      </div>
      <div class="note" id="msg"></div>
    </div>
  </div>

  <div class="graph-back-nav">
    <a href="/" class="graph-back-btn">Back</a>
  </div>

  <script>
    window.addEventListener('load', () => {
      // Sequence: Charge then Reveal
      setTimeout(() => document.getElementById('gen').classList.add('charged'), 800);
      setTimeout(() => document.body.classList.add('ready'), 1800);
    });
  </script>

  <script type="module" src="/scripts/plotindivE_noninteractive.js"></script>
</body>
</html>