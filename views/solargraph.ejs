<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Solar Energy</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root{
      --card-bg: rgba(255,255,255,.86);
      --text: #111827;
      --muted: #374151;
    }

    *{ box-sizing: border-box; }

    body{
      margin: 0;
      font-family: Arial, sans-serif;
      color: var(--text);
      overflow-x: hidden;
      background: #0b1020; /* base while loading */
    }

    /* ===== Page wrapper ===== */
    .page{
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      padding: 12px;
    }

    /* ===== SOLAR SUNRISE BACKGROUND ===== */
    .solar-sky{
      position: fixed;
      inset: 0;
      z-index: 5;
      background: linear-gradient(
        180deg,
        #0b1020 0%,
        #1e3a8a 40%,
        #fef3c7 100%
      );
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 1200ms ease, transform 2200ms cubic-bezier(.2,.9,.2,1);
    }
    .page.filled .solar-sky{
      opacity: 1;
      transform: translateY(0);
    }

    .sun{
      position: fixed;
      left: 50%;
      bottom: -80px;
      width: 260px;
      height: 260px;
      border-radius: 50%;
      transform: translateX(-50%) translateY(160px);
      background: radial-gradient(
        circle at 30% 30%,
        rgba(255,255,255,.95),
        rgba(251,191,36,.95),
        rgba(245,158,11,.9)
      );
      box-shadow: 0 0 110px rgba(251,191,36,.55);
      z-index: 6;
      transition: transform 2200ms cubic-bezier(.2,.9,.2,1);
    }
    .page.filled .sun{
      transform: translateX(-50%) translateY(0);
    }

    .rays{
      position: fixed;
      left: 50%;
      bottom: -60px;
      width: 560px;
      height: 560px;
      transform: translateX(-50%);
      z-index: 6;
      opacity: 0;
      pointer-events: none;
      background: conic-gradient(
        rgba(251,191,36,.18),
        transparent 20%,
        rgba(251,191,36,.18),
        transparent 40%,
        rgba(251,191,36,.18),
        transparent 60%,
        rgba(251,191,36,.18),
        transparent 80%,
        rgba(251,191,36,.18)
      );
      animation: solarPulse 3s ease-in-out infinite;
      transition: opacity 800ms ease 900ms;
      filter: blur(.4px);
    }
    .page.filled .rays{ opacity: 1; }

    @keyframes solarPulse{
      0%,100% { transform: translateX(-50%) scale(1); }
      50%     { transform: translateX(-50%) scale(1.05); }
    }

    /* ===== Content on top ===== */
    .content{
      position: relative;
      z-index: 30;
      max-width: 1100px;
      margin: 0 auto;
      padding-bottom: 120px;
      opacity: 0;
      transform: translateY(80px) scale(.99);
      transition: opacity 650ms ease, transform 1100ms cubic-bezier(.2,.9,.2,1);
    }
    .page.filled .content{
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    h2 { text-align: center; margin: 82px 0 18px; color: #0b1220; text-shadow: 0 1px 0 rgba(255,255,255,.35); }

    .controls{ text-align: center; margin-bottom: 12px; color: var(--muted); }
    select{
      padding: 8px 12px;
      font-size: 16px;
      border-radius: 10px;
      border: 1px solid rgba(0,0,0,.12);
      background: rgba(255,255,255,.9);
    }

    .chart-wrap{
      max-width: 1000px;
      margin: 0 auto;
      background: var(--card-bg);
      padding: 18px;
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,.35);
      box-shadow: 0 18px 50px rgba(0,0,0,.12);
      backdrop-filter: blur(10px);
    }

    canvas { width: 100% !important; height: 450px !important; }

    .msg{
      max-width: 1000px;
      margin: 10px auto 0;
      text-align: center;
      color: #b00020;
      font-weight: bold;
      display: none;
    }

    .graph-back-nav{
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      justify-content: center;
      z-index: 2000;
    }

    .graph-back-btn{
      width: 120px;
      height: 60px;
      background: #343a40;
      color: white;
      border-radius: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 14px;
      text-decoration: none;
      transition: 0.2s ease;
      box-shadow: 0 12px 28px rgba(0,0,0,.18);
    }
    .graph-back-btn:hover{ background: #23272b; }
  </style>
</head>

<body>
  <div class="page" id="page">
    <!-- Sunrise layers -->
    <div class="solar-sky"></div>
    <div class="sun"></div>
    <div class="rays"></div>

    <div class="content">
      <h2>Whole Campus Solar Energy (kWh)</h2>

      <div class="controls">
        <label for="datasetSelector">Choose data:</label>
        <select id="datasetSelector">
          <option value="field3">Urban Renewables</option>
          <option value="field4">Green House (kWh)</option>
          <option value="field5">Total Solar Energy</option>
        </select>
      </div>

      <div class="chart-wrap">
        <canvas id="solarChart"></canvas>
      </div>

      <div class="msg" id="msgBox"></div>
    </div>

    <div class="graph-back-nav">
      <a href="/" class="graph-back-btn">Back</a>
    </div>

    <!-- AUTO START sunrise + chart render -->
    <script>
      const page = document.getElementById("page");

      window.addEventListener("load", () => {
        setTimeout(() => {
          page.classList.add("filled");
        }, 200);

        // render chart after sunrise begins (prevents "pop")
        setTimeout(() => {
          window.dispatchEvent(new Event("solar:render"));
        }, 700);
      });
    </script>

    <!-- ✅ keep your module file -->
    <script type="module" src="/scripts/plotgraph.js"></script>
  </div>
</body>
</html>
