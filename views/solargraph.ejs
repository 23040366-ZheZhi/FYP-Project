<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Solar Energy</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root{
      --card-bg: rgba(255,255,255,.86);
      --text: #111827;
      --muted: #374151;
      --focus: rgba(59,130,246,.18);
    }

    *{ box-sizing: border-box; }

    body{
      margin: 0;
      font-family: Arial, sans-serif;
      color: var(--text);
      overflow-x: hidden;
      overflow-y: auto;
      background: #0b1020; /* base while loading */
    }

    /* ===== Page wrapper ===== */
    .page{
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      padding: 12px;
    }

    /* ===== SOLAR SUNRISE BACKGROUND (KEEP SAME) ===== */
    .solar-sky{
      position: fixed;
      inset: 0;
      z-index: 5;
      background: linear-gradient(
        180deg,
        #0b1020 0%,
        #1e3a8a 40%,
        #fef3c7 100%
      );
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 1200ms ease, transform 2200ms cubic-bezier(.2,.9,.2,1);
    }
    .page.filled .solar-sky{
      opacity: 1;
      transform: translateY(0);
    }

    .sun{
      position: fixed;
      left: 50%;
      bottom: -80px;
      width: 260px;
      height: 260px;
      border-radius: 50%;
      transform: translateX(-50%) translateY(160px);
      background: radial-gradient(
        circle at 30% 30%,
        rgba(255,255,255,.95),
        rgba(251,191,36,.95),
        rgba(245,158,11,.9)
      );
      box-shadow: 0 0 110px rgba(251,191,36,.55);
      z-index: 6;
      transition: transform 2200ms cubic-bezier(.2,.9,.2,1);
    }
    .page.filled .sun{
      transform: translateX(-50%) translateY(0);
    }

    .rays{
      position: fixed;
      left: 50%;
      bottom: -60px;
      width: 560px;
      height: 560px;
      transform: translateX(-50%);
      z-index: 6;
      opacity: 0;
      pointer-events: none;
      background: conic-gradient(
        rgba(251,191,36,.18),
        transparent 20%,
        rgba(251,191,36,.18),
        transparent 40%,
        rgba(251,191,36,.18),
        transparent 60%,
        rgba(251,191,36,.18),
        transparent 80%,
        rgba(251,191,36,.18)
      );
      animation: solarPulse 3s ease-in-out infinite;
      transition: opacity 800ms ease 900ms;
      filter: blur(.4px);
    }
    .page.filled .rays{ opacity: 1; }

    @keyframes solarPulse{
      0%,100% { transform: translateX(-50%) scale(1); }
      50%     { transform: translateX(-50%) scale(1.05); }
    }

    /* ===== Content on top ===== */
    .content{
      position: relative;
      z-index: 30;
      max-width: 1100px;
      margin: 0 auto;
      padding-bottom: 120px;
      opacity: 0;
      transform: translateY(80px) scale(.99);
      transition: opacity 650ms ease, transform 1100ms cubic-bezier(.2,.9,.2,1);
    }
    .page.filled .content{
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    h2{
      text-align: center;
      margin: 82px 0 18px;
      color: white;
      text-shadow: 0 1px 0 rgba(255,255,255,.20);
      font-weight: 800;
    }

    /* ===== Make Solar card look like Water card (layout only) ===== */
    .chart-wrap{
      max-width: 1000px;
      margin: 0 auto;
      background: var(--card-bg);
      padding: 18px;
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,.35);
      box-shadow: 0 18px 50px rgba(0,0,0,.12);
      backdrop-filter: blur(10px);
      position: relative;
      overflow: hidden;
    }

    .chart-wrap::before{
      content:"";
      position:absolute;
      inset:-40px;
      background: radial-gradient(circle at 30% 20%, rgba(255,255,255,.25), transparent 55%);
      pointer-events:none;
    }

    /* header / divider like Water */
    .sr-only{
      position:absolute;
      width:1px; height:1px;
      padding:0; margin:-1px;
      overflow:hidden;
      clip:rect(0,0,0,0);
      border:0;
    }

    .chart-body{
      display:flex;
      flex-direction:column;
      min-height:520px; /* so footer stays bottom */
      position: relative;
      z-index: 2;
    }

    .chart-header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding: 6px 4px 10px;
    }

    .chart-title-main{
      font-weight: 800;
      font-size: 18px;
      color: #0b1220;
      letter-spacing: .2px;
    }

    .chart-title-sub{
      margin-top: 2px;
      font-size: 12px;
      color: rgba(17,24,39,.65);
    }

    .chart-divider{
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(0,0,0,.12), transparent);
      margin: 2px 0 12px;
    }

    .chart-area{
      flex: 1;
      min-height: 420px;
    }

    canvas{
      width: 100% !important;
      height: 450px !important;
      display:block;
    }

    /* dropdown footer (same idea as your Water page) */
    .chart-footer{
      margin-top:auto;
      padding-top:12px;
      border-top:1px solid rgba(0,0,0,.10);
      display:flex;
      align-items:center;
      justify-content:center;
      gap:10px;
    }

    .chart-footer select{
      min-width:240px;
      padding:10px 14px;
      font-size:14px;
      border-radius:999px;
      border:1px solid rgba(0,0,0,.10);
      background: rgba(255,255,255,.72);
      backdrop-filter: blur(6px);
      box-shadow: 0 8px 18px rgba(0,0,0,.06);
    }

    .chart-footer select:focus{
      outline:none;
      border-color: rgba(59,130,246,.55);
      box-shadow: 0 0 0 4px var(--focus);
    }

    .msg{
      max-width: 1000px;
      margin: 10px auto 0;
      text-align: center;
      color: #b00020;
      font-weight: bold;
      display: none;
      position: relative;
      z-index: 40;
    }

    .graph-back-nav{
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      justify-content: center;
      z-index: 2000;
    }

    .graph-back-btn{
      width: 120px;
      height: 60px;
      background: #343a40;
      color: white;
      border-radius: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 14px;
      text-decoration: none;
      transition: 0.2s ease;
      box-shadow: 0 12px 28px rgba(0,0,0,.18);
    }
    .graph-back-btn:hover{ background: #23272b; }
  </style>
</head>

<body>
  <div class="page" id="page">
    <!-- Sunrise layers (KEEP SAME) -->
    <div class="solar-sky"></div>
    <div class="sun"></div>
    <div class="rays"></div>

    <div class="content">
      <h2>Whole Campus Solar Energy (kWh)</h2>

      <!-- ✅ Solar card now matches Water card layout -->
      <div class="chart-wrap" id="chartCard">
        <div class="chart-body">

          <div class="chart-header">
            <div class="chart-title">
              <div class="chart-title-main">Solar Energy</div>
              <div class="chart-title-sub">Monthly (kWh)</div>
            </div>
          </div>

          <div class="chart-divider"></div>

          <div class="chart-area">
            <canvas id="solarChart"></canvas>
          </div>

          <!-- ✅ dropdown moved to bottom like water graph -->
          <div class="chart-footer">
            <label class="sr-only" for="datasetSelector">Choose data</label>
            <select id="datasetSelector">
              <option value="field3">Urban Renewables</option>
              <option value="field4">Green House (kWh)</option>
              <option value="field5">Total Solar Energy</option>
            </select>
          </div>

        </div>
      </div>

      <div class="msg" id="msgBox"></div>
    </div>

    <div class="graph-back-nav">
      <a href="/" class="graph-back-btn">Back</a>
    </div>

    <!-- AUTO START sunrise + chart render (KEEP SAME) -->
    <script>
      const page = document.getElementById("page");

      window.addEventListener("load", () => {
        setTimeout(() => {
          page.classList.add("filled");
        }, 200);

        // render chart after sunrise begins (prevents "pop")
        setTimeout(() => {
          window.dispatchEvent(new Event("solar:render"));
        }, 700);
      });
    </script>

    

    <!-- ✅ keep your module file -->
    <script type="module" src="/scripts/plotgraph.js"></script>
    <script>
      window.__ROTATE_CFG__ = <%- JSON.stringify(rotateCfg) %>;
      console.log(window.__ROTATE_CFG__);
    </script>
    <script src="/scripts/idle-rotate.js"></script>


  </div>
</body>
</html>
