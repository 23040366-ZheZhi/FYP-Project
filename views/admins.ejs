<!DOCTYPE html>
<html>
<head>
    <title>Manage Admins</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/glass.css">
    <style>
        html, body {
        height: 100%;
        margin: 0;
        }

        body {
        background-image: url("/images/background.jpg");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        
        }
   </style>
</head>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<body>
<%- include('partials/navbar.ejs') %>
<div class="container mt-5">
    <h3 class="mb-3" style="color: white;">Admin Accounts</h3>

    <a href="/create-admin" class="btn btn-success mb-3">+ Create Admin</a>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>2FA</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        <% admins.forEach(admin => { %>
            <tr>
                <td><%= admin.username %></td>
                <td><%= admin.email %></td>
                <td>
                    <%= admin.twofa_enabled ? 'Enabled' : 'Disabled' %>
                </td>
                <td>
                    <a href="/admins/edit/<%= admin.id %>" class="btn btn-sm btn-primary">Edit</a>

                    <form action="/admins/delete/<%= admin.id %>" method="POST" style="display:inline;">
                        <button class="btn btn-sm btn-danger"
                                onclick="return confirm('Delete this admin?')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>

    <a href="/" class="btn btn-secondary">Back</a>
</div>

</body>
</html>
