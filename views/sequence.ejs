<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reorder Videos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

    <style>
        .list-group-item {
            cursor: grab;
        }
        .list-group-item:active {
            cursor: grabbing;
        }
    </style>
</head>
<body>

<%- include("partials/navbar.ejs") %>

<div class="container mt-4">
    <h2 class="text-center mb-4">Reorder Videos</h2>

    <form action="/sequence" method="POST">

        <ul id="videoList" class="list-group mb-3">
            <% videos.forEach(video => { %>
                <li class="list-group-item" data-id="<%= video.id %>">
                    <strong><%= video.name %></strong><br>
                    <small><%= video.description %></small>
                </li>
            <% }); %>
        </ul>

        <input type="hidden" id="orderInput" name="order">

        <button type="submit" class="btn btn-primary">Save Order</button>
        <a href="/" class="btn btn-secondary">Back</a>
    </form>
</div>

<script>
    new Sortable(videoList, {
        animation: 150,
        onEnd: () => {
            const newOrder = [...document.querySelectorAll("#videoList li")]
                                .map(li => li.dataset.id);

            document.getElementById("orderInput").value = newOrder.join(",");
        }
    });
</script>

</body>
</html>
