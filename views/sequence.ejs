<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reorder Videos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

    <style>
        .list-group-item { cursor: grab; }
        .list-group-item:active { cursor: grabbing; }
    </style>
</head>
<body>

<%- include("partials/navbar.ejs") %>

<div class="container mt-4">
    <h2 class="text-center mb-4">Reorder Videos</h2>

    <form action="/sequence" method="POST">

        <ul id="videoList" class="list-group mb-3">
            <% videos.forEach(video => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center" data-id="<%= video.id %>">
                    <div>
                        <strong>Name: <%= video.name %></strong><br>
                        <small>Description: <%= video.description %></small>
                    </div>
                    <button class="btn btn-danger btn-sm" onclick="deleteVideo(<%= video.id %>)" type="button"> <!-- Error is flagged, but code works -->
                        Delete
                    </button>
                </li>
            <% }); %>
        </ul>

        <input type="hidden" id="orderInput" name="order">

        <button type="submit" class="btn btn-primary">Save Order</button>
    </form>
    <br><br>
    <h2 class="text-center mb-4">Add New Videos</h2>

    <form action="/addVideo" method="POST" enctype="multipart/form-data">
        <div id="video-container">
            <!-- FIRST VIDEO BLOCK -->
            <div class="video-block mb-3">
                <div class="row mt-3">
                    <div class="col-md-3">
                        <label class="d-block">Video:</label>
                        <input type="file"
                        class="form-control"
                        name="videos[]"
                        accept="video/*"
                        onchange="previewVideo(this)"
                        required>
                    <label style="font-weight: bold; margin-top: 10px;">Thumbnail: </label>
                    <video class="w-100 d-none d-block" style="height:250px; object-fit:cover; margin-top:0; display:block;" controls></video>
                </div>

            </div>
                <label class="mt-3">Description:</label>
                <input type="text" class="form-control" name="descriptions[]" placeholder="Enter description">
            </div>
        </div>
            <!-- SUBMIT + BACK -->
            <button class="btn btn-primary mt-3" type="submit">Add Video</button>
            <!-- ADD BUTTON -->
            <button type="button" class="btn btn-success mt-3" onclick="addMore()">+ Add More Videos</button>
    </form>
</div>

<script>
    // Drag & drop reorder
    new Sortable(videoList, {
        animation: 150,
        onEnd: () => {
            const newOrder = [...document.querySelectorAll("#videoList li")]
                .map(li => li.dataset.id);
            document.getElementById("orderInput").value = newOrder.join(",");
        }
    });

    // Delete video
    function deleteVideo(id) {
        if (!confirm("Are you sure you want to delete this video?")) return;

        fetch(`/deleteVideo/${id}`, {
            method: "DELETE"
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert("Failed to delete video.");
            }
        })
        .catch(err => {
            console.error(err);
            alert("Error deleting video.");
        });
    }

    // Add more upload blocks
    function addMore() {
        const container = document.getElementById("video-container");
        const block = document.createElement("div");
        block.classList.add("video-block", "mb-3");
        block.innerHTML = `
            <label class="form-label">Video:</label>
            <input type="file" class="form-control" name="videos[]" accept="video/*" required>

            <label class="form-label mt-2">Description:</label>
            <input type="text" class="form-control" name="descriptions[]" placeholder="Enter description">

            <button type="button" class="btn btn-danger mt-2" onclick="removeBlock(this)">
                Delete Block
            </button>
        `;
        container.appendChild(block);
    }

    // Delete function for each additional block
    function removeBlock(btn) {
        const container = document.getElementById("video-container");
        const blocks = container.getElementsByClassName("video-block");

        // prevent deleting the last remaining block
        if (blocks.length <= 1) return;
        btn.closest(".video-block").remove();
    }

    // shows preview of video before adding
    function previewVideo(input) {
        const file = input.files[0];
        if (!file) return;

        const thumbnailLabel = input.nextElementSibling;
        const video = thumbnailLabel.nextElementSibling;
        const url = URL.createObjectURL(file);

        thumbnailLabel.classList.remove("d-none");
        video.classList.remove("d-none");
        video.src = url;
        video.load();
    }
</script>

</body>
</html>
