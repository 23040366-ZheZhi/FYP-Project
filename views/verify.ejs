<!DOCTYPE html>
<html>
<head>
    <title>Enter Verification Code</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5" style="max-width:400px;">
        <h3 class="text-center">Two-Factor Verification</h3>

        <p>A 6-digit verification code has been sent to your email.</p>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="/verify" method="POST">
            <label>Enter Code</label>
            <input type="number" name="code" class="form-control" required>

            <button class="btn btn-success mt-3 w-100">Verify</button>
        </form>

        <a href="/login" class="btn btn-secondary mt-2 w-100">Cancel</a>
    </div>
</body>
</html>
